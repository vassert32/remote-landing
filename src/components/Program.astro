---
import { roadmap } from '../data/content';
---

<section class="section program" id="programma" data-band="dark" data-program>
  <!-- Пин-зона: на десктопе с мотором этапы едут горизонтально -->
  <div class="program__pin" data-program-pin>
    <div class="shell program__rail">
      <div class="program__head">
        <h2 class="h2" data-split>Сопровождение всего маршрута</h2>
        <p class="body" data-reveal="blur">
          Не набор созвонов, а шесть последовательных этапов: от пересборки
          резюме до первых недель на новом месте.
        </p>
      </div>

      <div class="program__counter num-font" aria-hidden="true">
        <span class="program__digits">
          <span class="program__reel" data-program-digits>
            {roadmap.map((step) => <span class="program__digit">{step.num}</span>)}
          </span>
        </span>
        <span class="program__total">/ {roadmap[roadmap.length - 1]!.num}</span>
      </div>
    </div>

    <div class="shell"><div class="program__trackline"><span class="program__progress" data-program-progress></span></div></div>

    <div class="program__viewport">
      <ol class="program__steps" data-program-track>
        {
          roadmap.map((step) => (
            <li class="program__step" data-program-step>
              <span class="program__num num-font" aria-hidden="true">{step.num}</span>
              <div class="program__body">
                <h3 class="program__t">{step.title}</h3>
                <p class="body">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Рейка: слева заголовок с вводкой, справа скромный счётчик. */
  .program__rail {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-6);
  }

  .program__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 34rem;
  }

  .program__counter {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: 600;
    flex: none;
    padding-bottom: 0.3rem;
  }
  .program__digits {
    display: block;
    height: 1em;
    overflow: hidden;
    font-size: clamp(1.6rem, 1rem + 1.6vw, 2.6rem);
    line-height: 1;
  }
  .program__reel { display: block; will-change: transform; }
  .program__digit { display: block; height: 1em; line-height: 1; }

  .program__total {
    font-size: clamp(0.95rem, 0.7rem + 0.7vw, 1.3rem);
    color: var(--fg-mute);
  }

  .program__trackline {
    height: var(--hair);
    background: var(--line);
  }
  .program__progress {
    display: block;
    width: 100%;
    height: 2px;
    margin-top: -0.5px;
    background: var(--stamp);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* --- Этапы: вертикальный список (база и мобайл) ----------------------- */

  .program__viewport { overflow: hidden; }

  .program__steps {
    display: flex;
    flex-direction: column;
    padding-inline: var(--page-pad);
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .program__step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    padding-block: clamp(1.6rem, 1rem + 2.5vw, 2.75rem);
    border-top: var(--hair) solid var(--line-strong);
    transition: box-shadow var(--dur-mid) var(--ease-out);
  }
  .program__step:last-child { border-bottom: var(--hair) solid var(--line-strong); }

  /* Акцент живёт на этапе, а не на цифре: номер тихий, заголовок звучит. */
  .program__num {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--fg-faint);
    padding-top: 0.5rem;
    transition: color var(--dur-mid) var(--ease-out);
  }

  .program__t {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    line-height: 1.15;
  }

  .program__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .program__step.is-active .program__num { color: var(--stamp); }
  .program__step.is-active { box-shadow: inset 0 2px 0 var(--stamp); }

  @media (hover: hover) {
    .program__step:hover { background: color-mix(in srgb, var(--paper) 4%, transparent); }
    .program__step:hover .program__num { color: var(--stamp); }
  }

  @media (max-width: 900px) {
    .program__rail { flex-direction: column; align-items: flex-start; }
    .program__counter { display: none; }
    .program__trackline { display: none; }
  }

  /* --- Горизонтальная сцена: только десктоп с мотором ------------------- */
  @media (min-width: 901px) {
    :global(.motion) .program__pin {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100dvh;
      box-sizing: border-box;
      padding-block: calc(var(--nav-h) + var(--space-4)) var(--space-8);
    }

    :global(.motion) .program__steps {
      flex-direction: row;
      align-items: stretch;
      padding-inline: var(--page-pad);
      max-width: none;
      width: max-content;
    }

    :global(.motion) .program__step {
      width: clamp(30rem, 38vw, 36rem);
      flex: none;
      grid-template-columns: auto 1fr;
      border-top: 0;
      border-left: var(--hair) solid var(--line-strong);
      padding: var(--space-6) clamp(1.5rem, 2.5vw, 2.5rem) var(--space-6) clamp(1.25rem, 2vw, 2rem);
    }
    :global(.motion) .program__step:last-child { border-bottom: 0; }
  }
</style>
