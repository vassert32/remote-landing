---
import { roadmap } from '../data/content';
---

<section class="section program" id="programma" data-program>
  <div class="shell">
    <header class="program__head">
      <h2 class="h2" data-split>Сопровождение всего маршрута</h2>
      <p class="body" data-reveal="up">
        Не набор созвонов, а шесть последовательных этапов: от пересборки резюме
        до первых недель на новом месте.
      </p>
    </header>

    <div class="grid program__layout">
      <aside class="program__rail" data-program-rail aria-hidden="true">
        <div class="program__counter num">
          <span class="program__digits">
            <span class="program__reel" data-program-digits>
              {roadmap.map((step) => <span class="program__digit">{step.num}</span>)}
            </span>
          </span>
          <span class="program__total">/ {roadmap[roadmap.length - 1]!.num}</span>
        </div>
        <div class="program__track">
          <span class="program__progress" data-program-progress></span>
        </div>
      </aside>

      <ol class="program__steps">
        {
          roadmap.map((step) => (
            <li class="program__step" data-program-step>
              <span class="program__num num" aria-hidden="true">{step.num}</span>
              <div class="program__body">
                <h3 class="h3">{step.title}</h3>
                <p class="body">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .program__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: clamp(3rem, 1.5rem + 5vw, 6rem);
  }

  .program__layout { align-items: start; }

  /* Левая колонна прилипает, пока справа листаются этапы. Пин делает
     обычный sticky: GSAP здесь только считает прогресс и меняет цифру. */
  .program__rail {
    grid-column: 1 / 5;
    position: sticky;
    top: calc(var(--nav-h) + clamp(1.5rem, 4vh, 3.5rem));
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Обрезающий бокс и лента цифр обязаны быть разными элементами: если двигать
     сам бокс, из липкой колонки уезжает вся конструкция, а baseline-выравнивание
     флекса считает базовую линию по последней цифре ленты. */
  .program__counter {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    font-weight: 800;
  }

  .program__digits {
    position: relative;
    display: block;
    height: 1em;
    overflow: hidden;
    font-size: clamp(4rem, 1.5rem + 9vw, 9rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .program__reel { display: block; will-change: transform; }
  .program__digit {
    display: block;
    height: 1em;
    line-height: 1;
  }

  .program__total {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--ink-mute);
    padding-bottom: 0.18em;
  }

  .program__track {
    width: var(--hair);
    height: clamp(8rem, 24vh, 14rem);
    background: var(--rule);
  }
  .program__progress {
    display: block;
    width: 2px;
    height: 100%;
    margin-left: -0.5px;
    background: var(--stamp);
    transform: scaleY(0);
    transform-origin: top center;
  }

  .program__steps { grid-column: 6 / 13; }

  .program__step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(2rem, 1rem + 3.5vw, 3.75rem);
    border-top: var(--hair) solid var(--rule-strong);
  }
  .program__step:last-child { border-bottom: var(--hair) solid var(--rule-strong); }

  .program__num {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--ink-mute);
    padding-top: 0.4rem;
    transition: color var(--dur-mid) var(--ease-out);
  }

  .program__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Активный этап отмечается акцентом на номере. */
  .program__step.is-active .program__num { color: var(--stamp); }

  @media (max-width: 900px) {
    .program__rail { display: none; }
    .program__steps { grid-column: 1 / -1; }
  }
</style>
