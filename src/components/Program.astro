---
import { t } from '../i18n';

const c = t(Astro.currentLocale);
const roadmap = c.program.steps;
---

<section class="section program" id="programma" data-band="dark" data-program>
  <!-- Пин-зона: на десктопе с мотором этапы едут горизонтально -->
  <div class="program__pin" data-program-pin>
    <div class="shell program__rail">
      <div class="program__head">
        <h2 class="h2" data-split>{c.program.title}</h2>
        <p class="body" data-reveal="blur">{c.program.body}</p>
      </div>

      <div class="program__counter num-font" aria-hidden="true">
        <span class="program__digits">
          <span class="program__reel" data-program-digits>
            {roadmap.map((step) => <span class="program__digit">{step.num}</span>)}
          </span>
        </span>
        <span class="program__total">/ {roadmap[roadmap.length - 1]!.num}</span>
      </div>
    </div>

    <!-- Маршрутная полоса: шесть равных сегментов от старта до оффера.
         Пропорции условные, поэтому сроков внутри сегментов нет — только
         общая длительность, уже заявленная на странице. -->
    <div class="shell program__route">
      <span class="program__route-cap">{c.program.routeFrom}</span>
      <span class="program__route-line">
        {roadmap.map((step) => <span class="program__route-seg" data-route-seg data-num={step.num}></span>)}
        <span class="program__progress" data-program-progress></span>
      </span>
      <span class="program__route-cap program__route-cap--end">{c.program.routeTo}</span>
      <span class="program__route-span">{c.program.routeSpan}</span>
    </div>

    <div class="program__viewport">
      <ol class="program__steps" data-program-track>
        {
          roadmap.map((step) => (
            <li class="program__step" data-program-step>
              <span class="program__num num-font" aria-hidden="true">{step.num}</span>
              <div class="program__body">
                <h3 class="program__t">{step.title}</h3>
                <p class="body">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Рейка: слева заголовок с вводкой, справа скромный счётчик. */
  .program__rail {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .program__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 34rem;
  }

  .program__counter {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: var(--fw-num);
    flex: none;
    padding-bottom: 0.3rem;
  }
  .program__digits {
    display: block;
    height: 1em;
    overflow: hidden;
    font-size: clamp(1.6rem, 1rem + 1.6vw, 2.6rem);
    line-height: 1;
  }
  .program__reel { display: block; will-change: transform; }
  .program__digit { display: block; height: 1em; line-height: 1; }

  .program__total {
    font-size: clamp(0.95rem, 0.7rem + 0.7vw, 1.3rem);
    color: var(--fg-mute);
  }

  /* Маршрут: подписи по краям, между ними отрезок из шести сегментов. */
  .program__route {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: var(--space-4);
    /* Полоса дышит: карточки не втыкаются в неё рёбрами. */
    margin-bottom: clamp(2rem, 1.4rem + 2vw, 3.5rem);
  }

  .program__route-cap {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--fg-mute);
  }
  .program__route-cap--end { color: var(--stamp); }

  .program__route-line {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 3px;
    height: 6px;
  }
  .program__route-seg {
    background: var(--line-strong);
    transition: background-color var(--dur-mid) var(--ease-out);
  }
  .program__route-seg.is-done { background: color-mix(in srgb, var(--stamp) 55%, transparent); }
  .program__route-seg.is-active { background: var(--stamp); }

  .program__progress {
    position: absolute;
    inset: auto 0 -7px 0;
    height: 2px;
    background: var(--stamp);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .program__route-span {
    grid-column: 2;
    justify-self: center;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--fg-mute);
  }

  /* --- Этапы: вертикальный список (база и мобайл) ----------------------- */

  .program__viewport { overflow: hidden; }

  .program__steps {
    display: flex;
    flex-direction: column;
    padding-inline: var(--page-pad);
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .program__step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    padding-block: clamp(1.6rem, 1rem + 2.5vw, 2.75rem);
    border-top: var(--hair) solid var(--line-strong);
    transition: box-shadow var(--dur-mid) var(--ease-out);
  }
  .program__step:last-child { border-bottom: var(--hair) solid var(--line-strong); }

  /* Акцент живёт на этапе, а не на цифре: номер тихий, заголовок звучит. */
  .program__num {
    font-size: var(--fs-small);
    font-weight: var(--fw-num);
    color: var(--fg-mute);
    padding-top: 0.5rem;
    transition: color var(--dur-mid) var(--ease-out);
  }

  .program__t {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    line-height: 1.15;
  }

  .program__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .program__step.is-active .program__num { color: var(--stamp); }
  .program__step.is-active { box-shadow: inset 0 2px 0 var(--stamp); }

  @media (hover: hover) {
    .program__step:hover { background: color-mix(in srgb, var(--paper) 4%, transparent); }
    .program__step:hover .program__num { color: var(--stamp); }
  }

  @media (max-width: 900px) {
    .program__rail { flex-direction: column; align-items: flex-start; }
    .program__counter { display: none; }
    .program__route { grid-template-columns: auto 1fr auto; }
    .program__route-span { display: none; }
  }

  /* --- Горизонтальная сцена: только десктоп с мотором ------------------- */
  @media (min-width: 901px) {
    :global(.motion) .program__pin {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100dvh;
      box-sizing: border-box;
      padding-block: calc(var(--nav-h) + var(--space-4)) var(--space-8);
    }

    :global(.motion) .program__steps {
      flex-direction: row;
      align-items: stretch;
      padding-inline: var(--page-pad);
      max-width: none;
      width: max-content;
    }

    :global(.motion) .program__step {
      width: clamp(30rem, 38vw, 36rem);
      flex: none;
      grid-template-columns: auto 1fr;
      border-top: 0;
      border-left: var(--hair) solid var(--line-strong);
      /* Ребро карточки короче: сверху воздух, ребро не тянется к линии. */
      padding: var(--space-2) clamp(1.5rem, 2.5vw, 2.5rem) var(--space-6) clamp(1.25rem, 2vw, 2rem);
    }
    :global(.motion) .program__step:last-child { border-bottom: 0; }
  }
</style>
