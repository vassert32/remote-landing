---
import { t } from '../i18n';
import { pricingPlans, offerExample, calculatePlan } from '../data/pricing';

const c = t(Astro.currentLocale);
const amount = new Intl.NumberFormat(c.locale, { maximumFractionDigits: 0 });
const plans = pricingPlans.map((plan) => ({ ...plan, ...calculatePlan(plan) }));
const allCovered = plans.every((plan) => plan.remainingRub >= 0);
---

<section class="section section--band terms" id="usloviya">
  <div class="shell terms__inner">
    <header class="terms__head">
      <h2 class="h2 terms__title" data-split>{c.terms.title}</h2>
      <p class="body terms__body" data-reveal="blur">{c.terms.body}</p>
    </header>

    <div class="terms__example" data-reveal="up">
      <div>
        <p class="terms__offer-label">{c.terms.offerLabel}</p>
        <p class="terms__offer num-font">
          <span>${amount.format(offerExample.usdPerMonth)}</span>
          <span class="terms__approx">≈</span>
          <span>{amount.format(offerExample.rubPerMonth)} ₽</span>
        </p>
      </div>
      <p class="terms__summary">{allCovered ? c.terms.exampleSummary : c.terms.exampleNeutral}</p>
    </div>

    <div class="terms__plans" data-reveal="up">
      {plans.map((plan) => (
        <article class="tariff" aria-labelledby={'tariff-' + plan.id}>
          <h3 class="sr-only" id={'tariff-' + plan.id}>
            {c.terms.upfrontLabel}: {amount.format(plan.upfrontRub)} ₽
          </h3>
          <dl class="tariff__bill">
            <div class="tariff__row">
              <dt>{c.terms.upfrontLabel}</dt>
              <dd class="tariff__upfront num-font">
                {amount.format(plan.upfrontRub)}<span class="tariff__currency"> ₽</span>
              </dd>
            </div>
            <div class="tariff__row tariff__row--postpay">
              <dt>{c.terms.postpayLabel}</dt>
              <dd>
                <span class="tariff__postpay num-font">{plan.postpayPercent ? plan.postpayPercent + '%' : '0 ₽'}</span>
                <span class="tariff__note">{plan.postpayPercent ? c.terms.postpayNote : c.terms.noPostpayNote}</span>
              </dd>
            </div>
          </dl>
          <dl class="tariff__calculation">
            <div class="tariff__sum">
              <dt>{c.terms.postpayTotalLabel}</dt>
              <dd class="num">{amount.format(plan.postpayRub)} ₽</dd>
            </div>
            <div class="tariff__sum tariff__sum--total">
              <dt>{c.terms.totalLabel}</dt>
              <dd class="num">{amount.format(plan.totalRub)} ₽</dd>
            </div>
            <div class="tariff__balance">
              <dt>{plan.remainingRub >= 0 ? c.terms.remainingLabel : c.terms.shortfallLabel}</dt>
              <dd class="num-font">≈ {amount.format(Math.abs(plan.remainingRub))} ₽</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>

    <div class="terms__notes">
      <p>{c.terms.exampleNote}</p>
      <p>{c.terms.agreementNote}</p>
    </div>
  </div>
</section>

<style>
  .terms__inner { display: grid; gap: var(--space-8); }
  .terms__head { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: var(--col-gap); }
  .terms__title { max-width: 17ch; }
  .terms__body { max-width: 44ch; }

  /* Один бланк с тремя колонками: все варианты сравниваются по одним строкам. */
  .terms__example { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .terms__offer-label { margin-bottom: var(--space-3); font-size: var(--fs-small); color: var(--fg-soft); }
  .terms__offer { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5em; font-size: clamp(1.2rem, 0.8rem + 1.2vw, 1.85rem); font-weight: var(--fw-num); line-height: 1.2; }
  .terms__offer > span { white-space: nowrap; }
  .terms__approx { font-family: var(--font-sans); font-weight: var(--fw-medium); color: var(--fg-soft); }
  .terms__summary { max-width: 32ch; font-size: var(--fs-body); font-weight: var(--fw-medium); color: var(--fg-soft); }
  .terms__plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0; border: var(--hair) solid var(--line-strong); background: var(--bg); }
  .tariff { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); min-width: 0; padding: clamp(1.25rem, 0.7rem + 1.8vw, 2.25rem); }
  .tariff + .tariff { border-left: var(--hair) solid var(--line-strong); }
  .tariff__bill { display: grid; gap: var(--space-6); width: 100%; }
  .tariff__row { display: grid; gap: var(--space-4); }
  .tariff__row dt { font-size: var(--fs-small); color: var(--fg-soft); }
  .tariff__upfront { font-size: clamp(1.65rem, 0.8rem + 2.1vw, 2.8rem); font-weight: var(--fw-num); line-height: 1.15; white-space: nowrap; }
  .tariff__currency { font-size: 0.6em; color: var(--fg-soft); }
  .tariff__row--postpay { padding-top: var(--space-6); border-top: var(--hair) solid var(--line-strong); }
  .tariff__row--postpay dd { display: grid; gap: var(--space-3); }
  .tariff__postpay { color: var(--stamp); font-size: clamp(2rem, 1.2rem + 1.4vw, 2.75rem); font-weight: var(--fw-num); line-height: 1.1; }
  .tariff__note { font-size: var(--fs-small); color: var(--fg-soft); max-width: 28ch; text-wrap: pretty; }
  .tariff__calculation { display: grid; gap: var(--space-4); width: 100%; margin-top: auto; padding-top: var(--space-6); border-top: 2px solid var(--fg); }
  .tariff__sum { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: var(--space-4); font-size: var(--fs-small); color: var(--fg-soft); }
  .tariff__sum dd { white-space: nowrap; }
  .tariff__sum--total { font-weight: var(--fw-strong); color: var(--fg); }
  .tariff__balance { display: grid; gap: var(--space-3); padding-top: var(--space-4); border-top: var(--hair) solid var(--line-strong); }
  .tariff__balance dt { font-size: var(--fs-small); color: var(--fg-soft); }
  .tariff__balance dd { font-size: clamp(1.5rem, 1rem + 1.2vw, 2.1rem); font-weight: var(--fw-num); line-height: 1.2; white-space: nowrap; }
  .terms__notes { display: grid; gap: var(--space-3); font-size: var(--fs-small); color: var(--fg-soft); max-width: 80ch; }

  @media (max-width: 900px) {
    .terms__head { grid-template-columns: 1fr; gap: var(--space-6); }
    .terms__plans { grid-template-columns: 1fr; }
    .tariff { gap: var(--space-6); }
    .tariff + .tariff { border-left: 0; border-top: var(--hair) solid var(--line-strong); }
    .tariff__bill { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
    .tariff__row--postpay { padding-top: 0; border-top: 0; }
    .tariff__upfront { font-size: clamp(1.65rem, 1rem + 2.5vw, 2.8rem); }
  }
  @media (max-width: 560px) {
    .tariff__bill { grid-template-columns: 1fr; gap: var(--space-6); }
    .tariff__row--postpay { padding-top: var(--space-6); border-top: var(--hair) solid var(--line-strong); }
  }
</style>
