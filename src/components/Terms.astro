---
import { terms } from '../data/content';
---

<section class="section section--band terms" id="usloviya">
  <div class="shell">
    <header class="terms__head grid">
      <h2 class="h2 terms__title" data-split>Ноль на старте. Считаю с результата</h2>
      <p class="body terms__body" data-reveal="blur">
        Вся подготовка и сопровождение до оффера бесплатны. Мой счёт появляется
        один раз, и это половина вашей первой зарплаты после выхода на работу.
        Нет оффера, нет и счёта.
      </p>
    </header>

    <div class="panel bill-panel">
      <span class="panel__tag">расчёт</span>
    <dl class="bill">
      {
        terms.rows.map((row) => (
          <div class="bill__row" data-reveal="up">
            <dt class="bill__key">{row.key}</dt>
            <dd class="bill__val num-font">{row.value}</dd>
          </div>
        ))
      }
      <div class="bill__row bill__row--final" data-reveal="up">
        <dt class="bill__key bill__key--final">{terms.final.key}</dt>
        <dd class="bill__val bill__val--final num-font">{terms.final.value}</dd>
      </div>
    </dl>
    </div>
  </div>
</section>

<style>
  .terms__head { row-gap: var(--space-6); margin-bottom: clamp(3rem, 1.5rem + 5vw, 6rem); }
  .terms__title { grid-column: 1 / 8; }
  .terms__body { grid-column: 1 / 7; }

  .bill-panel { padding-block: 0.4rem; background: var(--bg); }
  .bill { margin: 0; }

  .bill__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-8);
    padding-block: clamp(1.1rem, 0.6rem + 1.6vw, 2rem);
    border-top: var(--hair) solid var(--line-strong);
  }
  .bill__row:last-child { border-bottom: 0; }
  .bill__row:first-child { border-top: 0; }

  .bill__key {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: var(--tr-mono);
    color: var(--fg-soft);
    text-wrap: balance;
  }

  .bill__val {
    flex: none;
    font-size: clamp(1.6rem, 0.8rem + 3.2vw, 3.4rem);
    font-weight: 550;
    line-height: 1;
    color: var(--fg-soft);
    margin: 0;
  }

  /* Итоговая строка: единственная сумма, которая реально появится. */
  .bill__row--final { border-top-width: 2px; border-top-color: var(--fg); }
  .bill__key--final { color: var(--fg); font-weight: 700; }
  .bill__val--final {
    color: var(--stamp);
    font-size: clamp(2.4rem, 0.9rem + 6vw, 5.6rem);
  }

  @media (max-width: 900px) {
    .terms__title, .terms__body { grid-column: 1 / -1; }
    .bill__row { gap: var(--space-4); }
  }
</style>
