---
import { terms } from '../data/content';
---

<section class="section section--band terms" id="usloviya">
  <div class="shell grid terms__grid">
    <header class="terms__head">
      <h2 class="h2 terms__title" data-split>Ноль на старте. Считаю с результата</h2>
      <p class="body terms__body" data-reveal="blur">
        Вся подготовка и сопровождение до оффера бесплатны. Мой счёт появляется
        один раз, и это половина вашей первой зарплаты после выхода на работу.
        Нет оффера, нет и счёта.
      </p>
    </header>

    <div class="panel bill-panel" data-reveal="up">
      <span class="panel__tag">расчёт</span>
    <dl class="bill">
      {
        terms.rows.map((row) => (
          <div class="bill__row" data-reveal="up">
            <dt class="bill__key">{row.key}</dt>
            <dd class="bill__val num-font">{row.value}</dd>
          </div>
        ))
      }
      <div class="bill__row bill__row--final" data-reveal="up">
        <dt class="bill__key bill__key--final">{terms.final.key}</dt>
        <dd class="bill__val bill__val--final num-font">{terms.final.value}</dd>
      </div>
    </dl>
    </div>
  </div>
</section>

<style>
  /* Двухколонник: слева заголовок и вводка, справа компактный расчёт.
     Плотно, по центру секции, без сквозной пустоты. */
  .terms__grid { align-items: center; row-gap: var(--space-8); }
  .terms__head {
    grid-column: 1 / 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .terms__title { max-width: 14ch; }
  .terms__body { max-width: 40ch; }

  .bill-panel { grid-column: 7 / 13; padding-block: 0.4rem; background: var(--bg); }
  .bill { margin: 0; }

  .bill__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: clamp(0.9rem, 0.5rem + 1.2vw, 1.4rem);
    border-top: var(--hair) solid var(--line-strong);
  }
  .bill__row:last-child { border-bottom: 0; }
  .bill__row:first-child { border-top: 0; }

  .bill__key {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: var(--tr-mono);
    color: var(--fg-soft);
    text-wrap: balance;
  }

  .bill__val {
    flex: none;
    font-size: clamp(1.35rem, 0.7rem + 2.2vw, 2.4rem);
    font-weight: 550;
    line-height: 1;
    color: var(--fg-soft);
    margin: 0;
  }

  /* Итоговая строка: единственная сумма, которая реально появится. */
  .bill__row--final { border-top-width: 2px; border-top-color: var(--fg); }
  .bill__key--final { color: var(--fg); font-weight: 700; }
  .bill__val--final {
    color: var(--stamp);
    font-size: clamp(2rem, 0.8rem + 4vw, 4rem);
  }

  @media (max-width: 900px) {
    .terms__head { grid-column: 1 / -1; }
    .bill-panel { grid-column: 1 / -1; }
    .bill__row { gap: var(--space-4); }
  }
</style>
