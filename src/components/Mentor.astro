---
import { Image } from 'astro:assets';
import mentor from '../assets/mentor.jpg';
import MentorIncomeChart from './MentorIncomeChart.astro';
import { t } from '../i18n';
import '../styles/mentor.css';

const c = t(Astro.currentLocale);
---

<section class="section mentor" id="mentor" data-band="dark">
  <div class="shell mentor__grid">
    <figure class="mentor__figure" data-reveal="up">
      <Image
        src={mentor}
        alt={c.mentor.photoAlt}
        widths={[420, 620, 900]}
        sizes="(max-width: 560px) 90vw, (max-width: 900px) 448px, 38vw"
        loading="lazy"
        decoding="async"
      />
      <!-- Идентификация врезана прямо в кадр, как табличка на приборе. -->
      <figcaption class="mentor__plate">
        {
          c.mentor.plate.map((row) => (
            <div class="doc__row">
              <span class="doc__key">{row.key}</span>
              <span class="doc__val">{row.value}</span>
            </div>
          ))
        }
      </figcaption>
    </figure>

    <div class="mentor__text">
      <h2 class="h2" data-split>{c.mentor.title}</h2>
      <div class="mentor__copy">
        {c.mentor.paragraphs.map((p) => <p class="body" data-reveal="blur">{p}</p>)}
      </div>
      <div class="mentor__chart">
        <MentorIncomeChart />
      </div>
    </div>
  </div>
</section>
