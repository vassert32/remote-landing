<!-- Кастомный курсор: точка идёт мгновенно, кольцо догоняет с инерцией.
     Включает его мотор и только на устройствах с мышью; blend difference
     инвертирует цвет на любом фоне сам. -->
<div class="cursor" data-cursor-root aria-hidden="true">
  <span class="cursor__dot"></span>
  <span class="cursor__ring"></span>
</div>

<style>
  .cursor {
    position: fixed;
    inset: 0;
    z-index: var(--z-cursor);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .cursor.is-on { opacity: 1; }

  .cursor__dot,
  .cursor__ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%; /* исключение из Shape Lock: курсор — инструмент, не документ */
    mix-blend-mode: difference;
  }

  .cursor__dot {
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    background: #f2f1ed;
  }

  .cursor__ring {
    width: 38px;
    height: 38px;
    margin: -19px 0 0 -19px;
    border: 1.5px solid #f2f1ed;
    transition: transform var(--dur-mid) var(--ease-out), opacity var(--dur-mid) var(--ease-out);
  }

  /* Над интерактивом кольцо растёт, точка остаётся прицелом. */
  .cursor.is-hot .cursor__ring { transform: scale(1.7); opacity: 0.75; }

  /* Системный курсор прячем только когда кастомный реально работает. */
  :global(html.has-cursor) { cursor: none; }
  :global(html.has-cursor) :is(a, button, summary) { cursor: none; }
</style>
