---
import { Icon } from 'astro-icon/components';
import { t, links } from '../i18n';

const c = t(Astro.currentLocale);

/**
 * Вопрос разрезается на буквы на этапе СБОРКИ, а не в браузере: печать
 * стартует мгновенно вместе с первой отрисовкой и работает без JS.
 * Пробелы между словами обязаны быть настоящими текстовыми узлами: без них
 * между inline-block-словами нет точки переноса, и строка уезжает за край.
 */
let i = 0;
const qHtml = c.hero.question
  .split(' ')
  .map(
    (word) =>
      '<span class="hero__word">' +
      [...word].map((ch) => `<span class="hero__ch" style="--i:${i++}">${ch}</span>`).join('') +
      '</span>',
  )
  .join(' ');
const total = i;
---

<section class="hero" id="top" data-hero data-band="dark">
  <div class="hero__stage">
    <!-- Фаза 1: вопрос на чёрном -->
    <div class="hero__phase hero__question" data-hero-question>
      <h1 class="hero__q display" style={`--n:${total}`} aria-label={c.hero.question}>
        <span aria-hidden="true" class="hero__q-letters"><Fragment set:html={qHtml} /><span class="hero__caret" aria-hidden="true"></span></span>
      </h1>
    </div>

    <!-- Фаза 2: ответ на бумаге -->
    <div class="hero__phase hero__answer" data-hero-answer>
      <div class="shell grid hero__grid">
        <div class="hero__main">
          <h2 class="display hero__title">
            {c.hero.answer.map((line) => (
              <span class="hero__mask"><span class="hero__line" data-hero-line>{line}</span></span>
            ))}
          </h2>

          <p class="lead hero__lead" data-hero-rise>
            {
              c.hero.leadParts.map((part) =>
                part.mark ? <mark class="mark">{part.t}</mark> : <Fragment>{part.t}</Fragment>,
              )
            }
          </p>

          <div class="hero__actions" data-hero-rise>
            <a class="btn btn--ink" href={links.telegram} target="_blank" rel="noopener" data-magnetic>
              <span>{c.cta.label}</span>
              <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
            </a>
            <a class="btn btn--ghost" href="#programma">
              <span>{c.ui.howItWorks}</span>
              <Icon class="btn__arrow" name="ph:arrow-down-bold" />
            </a>
          </div>
        </div>

        <figure class="hero__aside" data-hero-doc>
          <div class="doc offer">
            <figcaption class="doc__head offer__head">
              <span class="offer__title">{c.offer.docTitle}</span>
            </figcaption>

            <div class="offer__body">
              {
                c.offer.rows.map((row) => (
                  <div class="offer__row">
                    <span class="offer__key">{row.key}</span>
                    <span class="offer__val">{row.value}</span>
                  </div>
                ))
              }
            </div>

            <!-- Печать работодателя стоит, подпись читателя ещё нет:
                 приглашение, а не запись о состоявшемся факте.
                 Поле ввода не имитируем — подписью служит настоящая кнопка. -->
            <div class="offer__sign">
              <div class="offer__sign-field">
                <span class="offer__sign-label">{c.offer.signLabel}</span>
                <a class="offer__sign-btn" href={links.telegram} target="_blank" rel="noopener">
                  <span>{c.offer.signCta}</span>
                  <Icon class="offer__sign-arrow" name="ph:arrow-up-right-bold" aria-hidden="true" />
                </a>
              </div>
              <span class="stamp offer__stamp" data-hero-stamp>{c.offer.stamp}</span>
            </div>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------
     Сцена. Без мотора: два обычных экрана подряд (вопрос, затем ответ) —
     всё читаемо. С мотором: .hero__stage пинится, фазы накладываются,
     фон ведётся скрабом от угля к бумаге.
     -------------------------------------------------------------------- */

  .hero { background: var(--coal); }
  .hero__stage { position: relative; }

  .hero__phase {
    min-height: 100dvh;
    display: flex;
    align-items: center;
  }

  /* --- Вопрос ---------------------------------------------------------- */

  .hero__question {
    justify-content: center;
    padding-inline: var(--page-pad);
  }

  .hero__q {
    font-size: clamp(1.9rem, 0.6rem + 4.6vw, 4.3rem);
    max-width: min(100%, 19ch);
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
  }

  .hero__word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero__ch {
    position: relative;
    display: inline-block;
    opacity: 0;
    /* Печать: буквы появляются мгновенно, по одной, слева направо. */
    animation: hero-type 1ms steps(1) forwards;
    animation-delay: calc(260ms + var(--i) * 42ms);
  }

  /* Бегущая каретка: у каждой буквы своя, горит ровно один шаг печати
     и гаснет, когда загорается у следующей. Ноль JS. */
  .hero__ch::after {
    content: "";
    position: absolute;
    top: 0.07em;
    right: -0.14em;
    width: 0.085em;
    height: 0.9em;
    background: var(--stamp);
    opacity: 0;
    animation: hero-caret-run 46ms linear;
    animation-delay: calc(260ms + var(--i) * 42ms);
  }

  /* Финальная каретка появляется, когда печать закончена, и мигает. */
  .hero__caret {
    display: inline-block;
    width: 0.085em;
    height: 0.9em;
    margin-inline-start: 0.12em;
    background: var(--stamp);
    transform: translateY(0.12em);
    opacity: 0;
    animation:
      hero-type 1ms steps(1) forwards,
      hero-caret-blink 940ms steps(1) infinite;
    animation-delay: calc(260ms + var(--n) * 42ms);
  }

  @keyframes hero-type { to { opacity: 1; } }
  @keyframes hero-caret-run { from, to { opacity: 1; } }
  @keyframes hero-caret-blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .hero__ch { animation: none; opacity: 1; }
    .hero__ch::after { animation: none; }
    .hero__caret { animation: none; opacity: 1; }
  }

  /* --- Ответ ------------------------------------------------------------ */

  .hero__answer {
    padding-block: calc(var(--nav-h) + var(--space-8)) var(--space-8);
  }

  .hero__grid {
    width: 100%;
    align-items: center;
    row-gap: var(--space-12);
  }

  .hero__main {
    grid-column: 1 / 8;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 0.8rem + 2vw, 2.5rem);
    container-type: inline-size;
  }

  .hero__title {
    /* Кегль от ширины колонки: строки заданы вручную и не переносятся. */
    font-size: clamp(1.75rem, 8.6cqi, 4.3rem);
    white-space: nowrap;
  }

  .hero__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em; /* нижние выносные кириллицы */
  }
  .hero__line { display: block; }

  .hero__lead { max-width: 48ch; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__aside {
    grid-column: 8 / 13;
    margin: 0;
  }

  /* Лист бумаги, а не панель интерфейса: сам лист светлее страницы,
     край тонкий, поля широкие как у настоящего бланка, тени нет. */
  .offer {
    background: #fbfaf7;
    border-width: var(--hair);
    border-color: color-mix(in srgb, var(--ink) 28%, transparent);
    color: var(--ink);
  }

  .offer__head {
    justify-content: center;
    padding: 1.5rem var(--offer-pad) 1.1rem;
    border-bottom-width: var(--hair);
    border-bottom-color: color-mix(in srgb, var(--ink) 22%, transparent);
  }
  .offer__title {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  /* Поля листа: широкие сверху и по бокам, как у печатного бланка. */
  .offer { --offer-pad: clamp(1.4rem, 0.9rem + 1.7vw, 2.6rem); }
  .offer__body { padding: 0.5rem var(--offer-pad) 0.9rem; }

  .offer__row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.34fr) 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: 0.78rem;
  }
  .offer__row + .offer__row {
    border-top: var(--hair) solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .offer__key {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }
  .offer__val {
    font-size: var(--fs-body);
    font-weight: 600;
    text-wrap: balance;
  }

  /* Блок подписи: короткая линия под подпись и настоящая кнопка вместо
     имитации поля ввода. Печать работодателя уже стоит. */
  .offer__sign {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding: 1.3rem var(--offer-pad) 1.8rem;
    border-top: var(--hair) solid color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .offer__sign-field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    min-width: 0;
  }
  .offer__sign-label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }
  /* Подпись ставится кликом: кнопка ведёт на то же целевое действие. */
  .offer__sign-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: var(--hair) solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--tr-mono);
    color: var(--ink);
    transition: background-color var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .offer__sign-btn:hover,
  .offer__sign-btn:focus-visible {
    background: var(--ink);
    border-color: var(--ink);
    color: #fbfaf7;
  }
  .offer__sign-arrow { width: 0.8em; height: 0.8em; flex: none; }

  .offer__stamp {
    flex: none;
    align-self: center;
    padding: 0.5rem 0.95rem;
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
    /* Печать всегда чернильно-оранжевая: лист светлый в обеих темах. */
    border-color: #d9531e;
    color: #d9531e;
  }

  /* --- Наложение фаз в режиме мотора ------------------------------------ */

  :global(.motion) [data-hero-question] {
    position: absolute;
    inset: 0;
  }
  :global(.motion) [data-hero-answer] { position: relative; }

  @media (max-width: 1100px) {
    .hero__main { grid-column: 1 / -1; }
    .hero__aside { grid-column: 1 / -1; max-width: 30rem; }
  }

  /* Телефон: лист и текст ужимаются, чтобы первый экран ответа помещался
     целиком — иначе кнопка подписи уезжает за нижнюю кромку. */
  @media (max-width: 780px) {
    .hero__grid { row-gap: var(--space-8); }
    .hero__main { gap: var(--space-4); }
    .hero__answer { padding-block: calc(var(--nav-h) + var(--space-4)) var(--space-6); }
    .hero__lead { max-width: none; font-size: var(--fs-body); }
    .offer { --offer-pad: 1.1rem; }
    .offer__head { padding-block: 1rem 0.8rem; }
    .offer__body { padding-block: 0.2rem 0.5rem; }
    .offer__row { padding-block: 0.55rem; }
    .offer__sign { padding-block: 0.9rem 1.1rem; }
    .hero__q { font-size: clamp(1.75rem, 1.1rem + 3.4vw, 2.4rem); }
  }

  @media (max-width: 560px) {
    .offer__row { grid-template-columns: minmax(0, 1fr); gap: 0.15rem; }
    .offer__sign { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .offer__stamp { align-self: flex-end; margin-top: -2.4rem; }
    .hero__actions .btn { padding-block: 0.85rem; }
  }

  @media (max-width: 560px) {
    .hero__actions .btn { flex: 1 1 100%; justify-content: space-between; }
  }
</style>
