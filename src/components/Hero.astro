---
import { Icon } from 'astro-icon/components';
import { t, links } from '../i18n';
import OfferDoc from './OfferDoc.astro';

const c = t(Astro.currentLocale);

/**
 * Вопрос разрезается на буквы на этапе СБОРКИ, а не в браузере: печать
 * стартует мгновенно вместе с первой отрисовкой и работает без JS.
 * Пробелы между словами обязаны быть настоящими текстовыми узлами: без них
 * между inline-block-словами нет точки переноса, и строка уезжает за край.
 */
let i = 0;
const qHtml = c.hero.question
  .split(' ')
  .map(
    (word) =>
      '<span class="hero__word">' +
      [...word].map((ch) => `<span class="hero__ch" style="--i:${i++}">${ch}</span>`).join('') +
      '</span>',
  )
  .join(' ');
const total = i;
---

<section class="hero" id="top" data-hero data-band="dark">
  <div class="hero__stage">
    <!-- Фаза 1: вопрос на чёрном -->
    <div class="hero__phase hero__question" data-hero-question>
      <h1 class="hero__q display" style={`--n:${total}`} aria-label={c.hero.question}>
        <span aria-hidden="true" class="hero__q-letters"><Fragment set:html={qHtml} /><span class="hero__caret" aria-hidden="true"></span></span>
      </h1>
    </div>

    <!-- Фаза 2: ответ на бумаге -->
    <div class="hero__phase hero__answer" data-hero-answer>
      <div class="shell grid hero__grid">
        <div class="hero__main">
          <h2 class="display hero__title">
            {c.hero.answer.map((line) => (
              <span class="hero__mask"><span class="hero__line" data-hero-line>{line}</span></span>
            ))}
          </h2>

          <p class="lead hero__lead" data-hero-lead>
            {
              /*
               * Выделенное слово лежит в маркере дважды: снизу обычным текстом,
               * сверху — накладкой белым по оранжевому. Накладка прочерчивается
               * клипом слева направо, и буквы под ней перекрашиваются ровно так,
               * как это делает выделение текста мышью.
               *
               * Пробелов и переносов внутри <mark> быть не должно: любой отступ
               * в разметке станет текстовым узлом и разъедет накладку.
               */
              c.hero.leadParts.map((part) =>
                part.mark ? (
                  <mark class="mark"><span class="mark__hl" aria-hidden="true">{part.t}</span>{part.t}</mark>
                ) : (
                  <Fragment>{part.t}</Fragment>
                ),
              )
            }
          </p>

          <div class="hero__actions" data-hero-rise>
            <a class="btn btn--ink" href={links.telegram} target="_blank" rel="noopener" data-magnetic>
              <span>{c.cta.label}</span>
              <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
            </a>
            <a class="btn btn--ghost" href="#programma">
              <span>{c.ui.howItWorks}</span>
              <Icon class="btn__arrow" name="ph:arrow-down-bold" />
            </a>
          </div>
        </div>

        <figure class="hero__aside" data-hero-doc>
          <OfferDoc />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------
     Сцена. Без мотора: два обычных экрана подряд (вопрос, затем ответ) —
     всё читаемо. С мотором: .hero__stage пинится, фазы накладываются,
     фон ведётся скрабом от угля к бумаге.
     -------------------------------------------------------------------- */

  .hero { background: var(--coal); }
  .hero__stage { position: relative; }

  .hero__phase {
    /* svh: стабильная высота на iOS, пин не прыгает от адресной строки. */
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* --- Вопрос ---------------------------------------------------------- */

  .hero__question {
    justify-content: center;
    padding-inline: var(--page-pad);
  }

  .hero__q {
    font-size: clamp(1.9rem, 0.6rem + 4.6vw, 4.3rem);
    max-width: min(100%, 19ch);
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
  }

  .hero__word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero__ch {
    position: relative;
    display: inline-block;
    opacity: 0;
    /* Печать: буквы появляются мгновенно, по одной, слева направо. */
    animation: hero-type 1ms steps(1) forwards;
    animation-delay: calc(260ms + var(--i) * 42ms);
  }

  /* Бегущая каретка: у каждой буквы своя, горит ровно один шаг печати
     и гаснет, когда загорается у следующей. Ноль JS. */
  .hero__ch::after {
    content: "";
    position: absolute;
    top: 0.07em;
    right: -0.14em;
    width: 0.085em;
    height: 0.9em;
    background: var(--stamp);
    opacity: 0;
    animation: hero-caret-run 46ms linear;
    animation-delay: calc(260ms + var(--i) * 42ms);
  }

  /* Финальная каретка появляется, когда печать закончена, и мигает. */
  .hero__caret {
    display: inline-block;
    width: 0.085em;
    height: 0.9em;
    margin-inline-start: 0.12em;
    background: var(--stamp);
    transform: translateY(0.12em);
    opacity: 0;
    animation:
      hero-type 1ms steps(1) forwards,
      hero-caret-blink 940ms steps(1) infinite;
    animation-delay: calc(260ms + var(--n) * 42ms);
  }

  @keyframes hero-type { to { opacity: 1; } }
  @keyframes hero-caret-run { from, to { opacity: 1; } }
  @keyframes hero-caret-blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .hero__ch { animation: none; opacity: 1; }
    .hero__ch::after { animation: none; }
    .hero__caret { animation: none; opacity: 1; }
  }

  /* --- Ответ ------------------------------------------------------------ */

  .hero__answer {
    padding-block: calc(var(--nav-h) + var(--space-8)) var(--space-8);
  }

  .hero__grid {
    width: 100%;
    align-items: center;
    row-gap: var(--space-12);
  }

  .hero__main {
    grid-column: 1 / 8;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 0.8rem + 2vw, 2.5rem);
    container-type: inline-size;
  }

  .hero__title {
    /* Кегль от ширины колонки: строки заданы вручную и не переносятся. */
    font-size: clamp(1.75rem, 8.6cqi, 4.3rem);
    white-space: nowrap;
  }

  .hero__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em; /* нижние выносные кириллицы */
  }
  .hero__line { display: block; }

  .hero__lead { max-width: 48ch; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__aside {
    position: relative;
    grid-column: 8 / 13;
    margin: 0;
  }

  /* --- Наложение фаз в режиме мотора ------------------------------------ */

  :global(.motion) [data-hero-question] {
    position: absolute;
    inset: 0;
  }
  :global(.motion) [data-hero-answer] { position: relative; }

  @media (max-width: 1100px) {
    .hero__main { grid-column: 1 / -1; }
    .hero__aside { grid-column: 1 / -1; max-width: 30rem; }
  }

  /* Телефон: фаза ответа обязана влезать в svh-экран ЦЕЛИКОМ — пин держит
     вьюпорт, и всё, что ниже кромки, зритель не увидит вовсе (лист резался
     на «Подписи», печать била за кадром — DESIGN.md §14, М1). Решение
     заказчика: ужать всё в один экран. Отсюда тугие гэпы, кнопки в ряд
     и компактный бланк (своя ужимка в OfferDoc). */
  @media (max-width: 780px) {
    .hero__grid { row-gap: var(--space-4); }
    .hero__main { gap: var(--space-4); }
    .hero__answer { padding-block: calc(var(--nav-h) + var(--space-2)) var(--space-4); }
    .hero__lead { max-width: none; font-size: var(--fs-body); }
    .hero__q { font-size: clamp(1.75rem, 1.1rem + 3.4vw, 2.4rem); }

    /* Кнопки в ряд: столбик из двух съедал ~120px высоты фазы.
       Стрелки на этой ширине не помещаются вместе с полными лейблами —
       левая кнопка распиралась текстом до краёв; без них обе кнопки
       ровные, текст по центру. */
    .hero__actions { gap: var(--space-2); flex-wrap: nowrap; }
    .hero__actions .btn {
      flex: 1 1 auto;
      min-width: 0;
      justify-content: center;
      padding: 0.8rem 0.6rem;
      font-size: var(--fs-small);
    }
    .hero__actions .btn > span { white-space: nowrap; }
    .hero__actions .btn :global(.btn__arrow) { display: none; }
  }
</style>
