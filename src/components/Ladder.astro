---
import { Icon } from 'astro-icon/components';
import { t } from '../i18n';

const c = t(Astro.currentLocale);
const fmt = new Intl.NumberFormat(c.locale);
---

<section class="section ladder" id="put" data-band="dark">
  <div class="shell">
    <header class="ladder__head grid">
      <h2 class="h2 ladder__title" data-split>{c.ladder.title}</h2>
      <p class="body ladder__body" data-reveal="blur">{c.ladder.body}</p>
    </header>

    <div class="panel ladder__panel">
      <span class="panel__tag">{c.ladder.panelTag}</span>
    <ol class="cols" aria-label={c.ladder.chartLabel}>
      {
        c.ladder.points.map((point, i) => (
          <li
            class:list={[
              'col',
              {
                'col--peak': i === c.ladder.points.length - 1,
                /* Низкий столбик: сумма не влезает внутрь и встаёт над гранью. */
                'col--low': point.weight < 0.18,
              },
            ]}
            style={`--w:${point.weight.toFixed(3)}`}
            tabindex="0"
          >
            <div class="col__story" role="note">
              <p>{point.story}</p>
            </div>

            <span class="col__bar" data-reveal="bar">
              <span class="col__num num num-font">
                <span
                  data-count-to={point.value}
                  data-count-prefix={point.prefix}
                  data-count-suffix={point.suffix}
                >{point.prefix}{fmt.format(point.value)}{point.suffix}</span>
              </span>
            </span>

            <span class="col__stage">
              <Icon name={point.icon} class="col__stage-icon" aria-hidden="true" />
              {point.stage}
            </span>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>

<style>
  .ladder { padding-block: clamp(3rem, 2rem + 3vw, 5rem); }
  .ladder__head { row-gap: var(--space-4); margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .ladder__title { grid-column: 1 / 9; }
  .ladder__body { grid-column: 1 / 8; }

  .cols {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: end;
    column-gap: var(--col-gap);
    /* Поле высокое: столбец должен быть выше своей ширины, иначе
       читается прямоугольником, а не столбцом. */
    --field: clamp(11rem, 5rem + 15vw, 21rem);
  }

  .col {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    outline-offset: 4px;
  }

  .col__stage-icon {
    width: 0.95em;
    height: 0.95em;
    flex: none;
    color: var(--fg-mute);
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* Столбец: узкий и высокий, сумма напечатана внутри у основания.
     Масштаб ЛИНЕЙНЫЙ по рублёвому эквиваленту — просьба заказчика: разрыв
     между штатом и валютным оффером должен бить в глаза по-настоящему.
     Пол высоты — только чтобы грань нуля не исчезла совсем. */
  .col__bar {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: clamp(4.5rem, 2.5rem + 4.5vw, 8.5rem);
    height: max(calc(var(--field) * var(--w)), 0.4rem);
    padding: 0.55rem 0.7rem;
    background: color-mix(in srgb, var(--paper) 9%, var(--bg));
    box-shadow: inset 0 2px 0 var(--stamp);
    transform-origin: bottom center;
  }

  /* Сумма низкого столбика живёт над гранью: внутрь ей уже не влезть. */
  .col--low .col__bar { padding: 0; }
  .col--low .col__num {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.45rem);
  }

  .ladder__panel { padding-top: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem); }

  .col__num {
    font-weight: var(--fw-num);
    font-size: clamp(0.7rem, 0.45rem + 0.8vw, 0.95rem);
    line-height: 1.1;
    white-space: nowrap;
  }


  /* Подпись этапа под столбцом: крупнее прежнего, это несущий текст. */
  .col__stage {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.9rem;
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--fg-soft);
  }

  /* История: всплывает над колонной при наведении или фокусе. */
  .col__story {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.9rem);
    width: min(19rem, 74vw);
    padding: 0.85rem 1rem;
    background: var(--bg-deep);
    border: var(--hair) solid var(--line-strong);
    border-top: 2px solid var(--stamp);
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--fg-soft);
    opacity: 0;
    translate: 0 8px;
    pointer-events: none;
    transition: opacity var(--dur-mid) var(--ease-out),
                translate var(--dur-mid) var(--ease-out);
    z-index: 2;
  }
  /* Последние колонны прижимают карточку к правому краю, чтобы не резалась. */
  .col:nth-last-child(-n + 2) .col__story { left: auto; right: 0; }

  .col:hover .col__story,
  .col:focus-visible .col__story {
    opacity: 1;
    translate: 0 0;
  }
  .col:hover .col__stage-icon,
  .col:focus-visible .col__stage-icon { color: var(--stamp); }

  .col--peak .col__bar {
    background: color-mix(in srgb, var(--stamp) 34%, var(--bg));
    box-shadow: inset 0 2px 0 var(--stamp);
  }
  .col--peak .col__num { color: var(--stamp); }
  .col--peak .col__stage { color: var(--fg); font-weight: var(--fw-strong); }
  .col--peak .col__stage-icon { color: var(--stamp); }

  @media (max-width: 900px) {
    .ladder__title, .ladder__body { grid-column: 1 / -1; }
    .cols { --field: clamp(8rem, 3rem + 15vw, 12rem); column-gap: 0.7rem; }
    .col__bar { width: 100%; padding-inline: 0.45rem; }
    .col__num { font-size: clamp(0.62rem, 0.4rem + 0.7vw, 0.8rem); }
    .col__stage { font-size: var(--fs-micro); }
  }

  /* Ниже 560px пять колонн нечитаемы: разворачиваем в вертикальный список,
     история становится обычным текстом под строкой. */
  @media (max-width: 560px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      --field: 100%;
    }
    .col {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-4);
      padding-block: var(--space-4);
      border-top: var(--hair) solid var(--line);
    }
    /* Столбца нет — сумма остаётся, превращаясь в шильдик справа от этапа.
       Раньше она пряталась вместе со столбцом, потому что живёт внутри него. */
    .col__bar {
      grid-column: 2;
      grid-row: 1;
      width: auto;
      height: auto;
      justify-self: end;
      padding: 0.3rem 0.55rem;
      box-shadow: inset 0 2px 0 var(--stamp);
    }
    /* В шильдике сумма возвращается в поток: absolute тут не про что. */
    .col--low .col__bar { padding: 0.3rem 0.55rem; }
    .col--low .col__num { position: static; }
    .col__num { font-size: var(--fs-small); }
    .col__stage { grid-column: 1; grid-row: 1; margin-top: 0; font-size: var(--fs-small); }
    .col__story {
      position: static;
      grid-column: 1 / -1;
      width: 100%;
      opacity: 1;
      translate: none;
      pointer-events: auto;
      margin-top: var(--space-2);
      padding: 0.6rem 0.8rem;
      font-size: var(--fs-small);
      border-top-width: 2px;
    }
    .col { padding-block: var(--space-3); }
    .ladder__head { margin-bottom: var(--space-4); }
    .ladder__panel { padding: 1.4rem 1rem 1rem; }
  }
</style>
