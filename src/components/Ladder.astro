---
import { Icon } from 'astro-icon/components';
import { ladder } from '../data/content';

const fmt = new Intl.NumberFormat('ru-RU');
---

<section class="section ladder" id="put" data-band="dark">
  <div class="shell">
    <header class="ladder__head grid">
      <h2 class="h2 ladder__title" data-split>Путь, который можно повторить</h2>
      <p class="body ladder__body" data-reveal="blur">
        Школу Яндекса, стажировку и штат я прошёл сам, без связей и релокации.
        Поэтому помню, где на этом пути теряются месяцы и что на самом деле
        спрашивают на собеседованиях.
      </p>
    </header>

    <div class="panel ladder__panel">
      <span class="panel__tag">доход по этапам</span>
    <ol class="cols" aria-label="Рост дохода по этапам карьеры">
      {
        ladder.map((point, i) => (
          <li
            class:list={['col', { 'col--peak': i === ladder.length - 1 }]}
            style={`--w:${point.weight}`}
            tabindex="0"
          >
            <div class="col__story" role="note">
              <p>{point.story}</p>
            </div>

            <span class="col__icon" aria-hidden="true">
              <Icon name={point.icon} />
            </span>

            <span class="col__bar" data-reveal="bar" aria-hidden="true"></span>

            <span class="col__num readout num-font">
              <span
                class="num"
                data-count-to={point.value}
                data-count-prefix={point.prefix}
                data-count-suffix={point.suffix}
              >{point.prefix}{fmt.format(point.value)}{point.suffix}</span>
            </span>
            <span class="col__stage">{point.stage}</span>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>

<style>
  .ladder__head { row-gap: var(--space-6); margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem); }
  .ladder__title { grid-column: 1 / 9; }
  .ladder__body { grid-column: 1 / 8; }

  .cols {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: end;
    column-gap: var(--col-gap);
    /* Поле колонн: высота пиковой. */
    --field: clamp(9rem, 4rem + 13vw, 15rem);
  }

  .col {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    outline-offset: 4px;
  }

  .col__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: var(--space-4);
    border: var(--hair) solid var(--line-strong);
    color: var(--fg-mute);
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .col__icon :global(svg) { width: 1.15rem; height: 1.15rem; }

  /* Колонна: плоский графит с оранжевой кромкой сверху. */
  .col__bar {
    display: block;
    width: 100%;
    height: max(calc(var(--field) * var(--w)), 6px);
    background: var(--bg-deep);
    box-shadow: inset 0 2px 0 var(--stamp);
    transform-origin: bottom center;
  }

  .ladder__panel { padding-top: clamp(2.2rem, 2rem + 2vw, 3.4rem); }

  .col__num {
    display: inline-block;
    align-self: flex-start;
    margin-top: var(--space-4);
    font-weight: 550;
    font-size: clamp(0.82rem, 0.3rem + 1.45vw, 1.35rem);
    line-height: 1.15;
  }


  .col__stage {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    line-height: 1.4;
    color: var(--fg-mute);
  }

  /* История: всплывает над колонной при наведении или фокусе. */
  .col__story {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.9rem);
    width: min(19rem, 74vw);
    padding: 0.85rem 1rem;
    background: var(--bg-deep);
    border: var(--hair) solid var(--line-strong);
    border-top: 2px solid var(--stamp);
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--fg-soft);
    opacity: 0;
    translate: 0 8px;
    pointer-events: none;
    transition: opacity var(--dur-mid) var(--ease-out),
                translate var(--dur-mid) var(--ease-out);
    z-index: 2;
  }
  /* Последние колонны прижимают карточку к правому краю, чтобы не резалась. */
  .col:nth-last-child(-n + 2) .col__story { left: auto; right: 0; }

  .col:hover .col__story,
  .col:focus-visible .col__story {
    opacity: 1;
    translate: 0 0;
  }
  .col:hover .col__icon,
  .col:focus-visible .col__icon {
    color: var(--stamp);
    border-color: var(--stamp);
  }

  .col--peak .col__bar {
    background: color-mix(in srgb, var(--stamp) 26%, var(--bg-deep));
    box-shadow: inset 0 2px 0 var(--stamp);
  }
  .col--peak .col__num { color: var(--stamp); }
  .col--peak .col__stage { color: var(--fg); }
  .col--peak .col__icon { color: var(--stamp); border-color: var(--stamp); }

  @media (max-width: 900px) {
    .ladder__title, .ladder__body { grid-column: 1 / -1; }
    .cols { --field: clamp(7rem, 3rem + 14vw, 11rem); column-gap: 0.7rem; }
    .col__num { font-size: clamp(0.72rem, 0.28rem + 1.6vw, 1rem); }
  }

  /* Ниже 560px пять колонн нечитаемы: разворачиваем в вертикальный список,
     история становится обычным текстом под строкой. */
  @media (max-width: 560px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      --field: 100%;
    }
    .col {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      column-gap: var(--space-4);
      padding-block: var(--space-4);
      border-top: var(--hair) solid var(--line);
    }
    .col__bar { display: none; }
    .col__icon { margin-bottom: 0; }
    .col__num { grid-column: 3; margin-top: 0; }
    .col__stage { grid-column: 2; grid-row: 1; margin-top: 0; font-size: var(--fs-small); }
    .col__story {
      position: static;
      grid-column: 1 / -1;
      width: 100%;
      opacity: 1;
      translate: none;
      pointer-events: auto;
      margin-top: var(--space-3);
      border-top-width: 2px;
    }
  }
</style>
