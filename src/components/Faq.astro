---
import { Icon } from 'astro-icon/components';
import { t } from '../i18n';

const c = t(Astro.currentLocale);
const faq = c.faq.items;
---

<section class="section section--band faq" id="voprosy">
  <div class="shell grid faq__grid">
    <h2 class="h2 faq__title" data-split>{c.faq.title}</h2>

    <div class="faq__list">
      {
        faq.map((item, i) => (
          <article class:list={['faq__item', { 'is-open': i === 0 }]}>
            <h3 class="faq__h">
              <button class="faq__q" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                <span class="faq__q-text">{item.q}</span>
                <Icon name="ph:plus-bold" class="faq__icon" aria-hidden="true" />
              </button>
            </h3>
            <div class="faq__a-wrap">
              <p class="faq__a body">{item.a}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid { row-gap: var(--space-8); align-items: start; }

  .faq__title {
    grid-column: 1 / 5;
    position: sticky;
    top: calc(var(--nav-h) + var(--space-8));
  }

  .faq__list { grid-column: 6 / 13; }

  .faq__item { border-top: var(--hair) solid var(--line-strong); }
  .faq__item:last-child { border-bottom: var(--hair) solid var(--line-strong); }

  .faq__h { margin: 0; }

  .faq__q {
    width: 100%;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-6);
    text-align: left;
    font-size: var(--fs-h3);
    font-weight: var(--fw-strong);
    letter-spacing: -0.014em;
    line-height: 1.25;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .faq__q:hover { color: var(--stamp); }

  .faq__icon {
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
    align-self: center;
    transition: transform var(--dur-mid) var(--ease-out), color var(--dur-mid) var(--ease-out);
  }
  .faq__item.is-open .faq__icon { transform: rotate(45deg); color: var(--stamp); }

  /* Плавное раскрытие: сетка 0fr → 1fr, без магических высот. */
  .faq__a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-mid) var(--ease-out);
  }
  .faq__item.is-open .faq__a-wrap { grid-template-rows: 1fr; }
  .faq__a {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    /* Анимируется только opacity: высоту ведёт grid-template-rows обёртки.
       Паддинг здесь анимировать нельзя (layout-свойство, дёргает раскладку) —
       нижний отступ дан ::after-ом, который клипается вместе с контентом. */
    transition: opacity var(--dur-mid) var(--ease-out);
  }
  .faq__a::after { content: ''; display: block; height: var(--space-6); }
  .faq__item.is-open .faq__a { opacity: 1; }

  @media (max-width: 900px) {
    .faq__title { grid-column: 1 / -1; position: static; }
    .faq__list { grid-column: 1 / -1; }
    .faq__q { font-size: var(--fs-lead); }
  }
</style>

<script>
  // Аккордеон: один открыт, повторный клик закрывает.
  const items = [...document.querySelectorAll<HTMLElement>('.faq__item')];
  for (const item of items) {
    const btn = item.querySelector<HTMLButtonElement>('.faq__q');
    btn?.addEventListener('click', () => {
      // Мотор глушит скролл-снап на время транзишна высоты: иначе он
      // принимает ресайз контента за скролл и «доводит» страницу.
      document.dispatchEvent(new CustomEvent('ui:reflow'));
      const willOpen = !item.classList.contains('is-open');
      for (const other of items) {
        other.classList.toggle('is-open', other === item && willOpen);
        other.querySelector('.faq__q')?.setAttribute(
          'aria-expanded',
          String(other === item && willOpen),
        );
      }
    });
  }
</script>
