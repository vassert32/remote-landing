---
import { Icon } from 'astro-icon/components';
import { t, links, docHref } from '../i18n';
import BusinessDetails from './BusinessDetails.astro';

const c = t(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="closer">
  <div class="shell closer__inner">
    <p class="closer__kicker" data-reveal="up">{c.closer.kicker}</p>

    <div class="closer__head">
      <h2 class="closer__title h2" data-split>{c.closer.title}</h2>
      <!-- Цена входа во весь рост: последний аргумент перед кнопкой. -->
      <p class="closer__big" data-reveal="up">
        <span class="closer__big-num num-font">{c.closer.bigNum}</span>
        <span class="closer__big-note">{c.closer.bigNote}</span>
      </p>
    </div>

    <p class="closer__note body" data-reveal="blur">{c.closer.note}</p>

    <div class="closer__actions" data-reveal="up">
      <a class="btn btn--ink" href={links.telegram} target="_blank" rel="noopener" data-magnetic>
        <span>{c.cta.label}</span>
        <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
      </a>
    </div>

    <div class="closer__foot">
      <BusinessDetails showContacts={false} />
      <nav class="closer__documents" aria-label={c.legal.agreementLink}>
        <a href={docHref(Astro.currentLocale, 'dogovor')}>
          <span>{c.legal.agreementLink}</span>
          <span class="closer__draft">{c.legal.draft}</span>
        </a>
      </nav>
      <span class="closer__copyright">© <span class="num">{year}</span></span>
    </div>
  </div>
</footer>

<style>
  /* Финал занимает весь экран: контент по центру, подпись прижата к низу. */
  .closer {
    min-height: 100svh;
    display: flex;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem) 0;
  }

  .closer__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
  }
  /* Контент по центру свободного места, инфо-подвал прижат к низу. */
  .closer__kicker { margin-top: auto; }

  .closer__kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-mono);
    color: var(--fg-mute);
  }

  .closer__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    width: 100%;
  }
  .closer__title { max-width: 16ch; }

  .closer__big {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    flex: none;
  }
  .closer__big-num {
    font-size: var(--fs-giant);
    font-weight: var(--fw-display);
    line-height: 0.9;
    color: var(--stamp);
  }
  .closer__big-note {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--fg-mute);
  }

  @media (max-width: 780px) {
    .closer__head { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .closer__big { align-items: flex-start; }
  }

  .closer__note { color: var(--fg-soft); max-width: 44ch; }

  .closer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .closer__foot {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-8);
    margin-top: auto;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) var(--space-8);
    border-top: var(--hair) solid var(--line);
    font-size: var(--fs-small);
    color: var(--fg-mute);
  }

  .closer__documents { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .closer__documents a { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); color: var(--fg-soft); }
  .closer__documents a:hover, .closer__documents a:focus-visible { color: var(--stamp); }
  .closer__draft { font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--fg-mute); }
  .closer__copyright { font-family: var(--font-mono); font-size: var(--fs-micro); }

  @media (hover: none) {
    .closer__documents a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media (max-width: 560px) {
    .closer__actions { width: 100%; }
    .closer__actions :global(.btn) { width: 100%; justify-content: space-between; }
  }
</style>
