---
import { Icon } from 'astro-icon/components';
import { cta, site } from '../data/content';
const year = new Date().getFullYear();
---

<footer class="closer" data-band="dark">
  <div class="shell closer__inner">
    <p class="closer__kicker" data-reveal="up">Первый разбор бесплатный</p>

    <h2 class="closer__title h2" data-split>Следующий оффер может быть вашим</h2>

    <p class="closer__note body" data-reveal="blur">
      Созваниваемся, смотрим ваш опыт, английский и цель. После этого я честно
      говорю, есть ли смысл работать вместе.
    </p>

    <div class="closer__actions" data-reveal="up">
      <a class="btn btn--ink" href={cta.href} target="_blank" rel="noopener" data-magnetic>
        <span>{cta.label}</span>
        <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
      </a>
      <a class="closer__tg" href={cta.href} target="_blank" rel="noopener">
        <Icon name="ph:telegram-logo" class="closer__tg-icon" aria-hidden="true" />
        <span>{site.telegramHandle}</span>
      </a>
    </div>

    <!-- Информативный низ: разделы, контакты текстом, документы, реквизиты.
         Иконки живут в хедере — здесь не дублируются. -->
    <div class="closer__foot">
      <nav class="closer__col" aria-label="Разделы страницы">
        <span class="closer__col-title">Разделы</span>
        <a class="closer__flink" href="#put">Путь</a>
        <a class="closer__flink" href="#programma">Программа</a>
        <a class="closer__flink" href="#usloviya">Условия</a>
        <a class="closer__flink" href="#voprosy">Вопросы</a>
      </nav>

      <div class="closer__col">
        <span class="closer__col-title">Связь</span>
        <a class="closer__flink" href={cta.href} target="_blank" rel="noopener">{site.telegramHandle}</a>
        <!-- TODO(заказчик): реальные почта и GitHub — слоты оживут со ссылками -->
        <span class="closer__flink closer__flink--soon" title="Скоро">Почта</span>
        <span class="closer__flink closer__flink--soon" title="Скоро">GitHub</span>
      </div>

      <div class="closer__col">
        <span class="closer__col-title">Документы</span>
        <a class="closer__flink" href="/oferta">Публичная оферта</a>
        <a class="closer__flink" href="/dogovor">Договор менторства</a>
        <a class="closer__flink" href="/privacy">Политика конфиденциальности</a>
      </div>

      <div class="closer__col closer__col--legal">
        <span class="closer__col-title">Реквизиты</span>
        <span>{site.legal}</span>
        <span class="num closer__year">{year}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Финал занимает весь экран: контент по центру, подпись прижата к низу. */
  .closer {
    min-height: 100dvh;
    display: flex;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem) 0;
  }

  .closer__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
  }
  /* Контент по центру свободного места, инфо-подвал прижат к низу. */
  .closer__kicker { margin-top: auto; }

  .closer__kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: var(--tr-mono);
    color: var(--fg-mute);
  }

  .closer__title { max-width: 16ch; }

  .closer__note { color: var(--fg-soft); max-width: 44ch; }

  .closer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .closer__tg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--fg-soft);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .closer__tg:hover, .closer__tg:focus-visible { color: var(--fg); }
  .closer__tg-icon { width: 1.1rem; height: 1.1rem; }

  .closer__foot {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr 1fr;
    gap: var(--space-8);
    margin-top: auto;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) var(--space-8);
    border-top: var(--hair) solid var(--line);
    font-size: var(--fs-small);
    color: var(--fg-mute);
  }

  .closer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .closer__col--legal { align-items: flex-end; text-align: right; }

  .closer__col-title {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--fg-faint);
    margin-bottom: 0.25rem;
  }

  .closer__flink {
    color: var(--fg-soft);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .closer__flink:hover, .closer__flink:focus-visible { color: var(--fg); }

  .closer__flink--soon { opacity: 0.4; cursor: default; }
  .closer__flink--soon:hover { color: var(--fg-soft); }

  .closer__year { color: var(--fg-faint); }

  @media (max-width: 780px) {
    .closer__foot { grid-template-columns: 1fr 1fr; row-gap: var(--space-6); }
    .closer__col--legal { grid-column: 1 / -1; align-items: flex-start; text-align: left; flex-direction: row; justify-content: space-between; width: 100%; }
  }

  @media (max-width: 560px) {
    .closer__actions :global(.btn) { width: 100%; justify-content: space-between; }
  }
</style>
