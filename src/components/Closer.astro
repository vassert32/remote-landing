---
import { Icon } from 'astro-icon/components';
import { cta, site, socials } from '../data/content';
const year = new Date().getFullYear();
---

<footer class="closer" data-band="dark">
  <div class="shell closer__inner">
    <p class="closer__kicker" data-reveal="up">Первый разбор бесплатный</p>

    <h2 class="closer__title h2" data-split>Следующий оффер может быть вашим</h2>

    <p class="closer__note body" data-reveal="blur">
      Созваниваемся, смотрим ваш опыт, английский и цель. После этого я честно
      говорю, есть ли смысл работать вместе.
    </p>

    <div class="closer__actions" data-reveal="up">
      <a class="btn btn--ink" href={cta.href} target="_blank" rel="noopener" data-magnetic>
        <span>{cta.label}</span>
        <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
      </a>
      <a class="closer__tg" href={cta.href} target="_blank" rel="noopener">
        <Icon name="ph:telegram-logo" class="closer__tg-icon" aria-hidden="true" />
        <span>{site.telegramHandle}</span>
      </a>
    </div>

    <div class="closer__meta">
      <span>{site.legal}</span>
      <ul class="closer__socials">
        {
          socials.filter((s) => s.href).map((s) => (
            <li>
              <a class="iconbtn" href={s.href} target="_blank" rel="noopener" aria-label={s.name} data-magnetic>
                <Icon name={s.icon} />
              </a>
            </li>
          ))
        }
      </ul>
      <span class="num">{year}</span>
    </div>
  </div>
</footer>

<style>
  .closer {
    padding-block: clamp(5rem, 3rem + 8vw, 10rem) 0;
  }

  .closer__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
  }

  .closer__kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: var(--tr-mono);
    color: var(--fg-mute);
  }

  .closer__title { max-width: 16ch; }

  .closer__note { color: var(--fg-soft); max-width: 44ch; }

  .closer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .closer__tg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--fg-soft);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .closer__tg:hover, .closer__tg:focus-visible { color: var(--fg); }
  .closer__tg-icon { width: 1.1rem; height: 1.1rem; }

  .closer__meta {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-block: var(--space-6);
    border-top: var(--hair) solid var(--line);
    font-size: var(--fs-small);
    color: var(--fg-mute);
  }

  .closer__socials {
    display: flex;
    gap: var(--space-3);
  }

  @media (max-width: 560px) {
    .closer__actions :global(.btn) { width: 100%; justify-content: space-between; }
  }
</style>
