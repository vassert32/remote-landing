---
import { business, links, t } from '../i18n';

interface Props {
  showTax?: boolean;
}

const { showTax = false } = Astro.props;
const c = t(Astro.currentLocale);
---

<address class="business">
  <p class="business__name">{c.legal.name}</p>
  <p>{c.legal.address}</p>
  <dl class="business__details">
    <div><dt>{c.legal.innLabel}:</dt><dd class="num">{business.inn}</dd></div>
    <div><dt>{c.legal.ogrnipLabel}:</dt><dd class="num">{business.ogrnip}</dd></div>
  </dl>
  <p>{c.legal.emailLabel}: <a href={links.email}>{business.email}</a></p>
  <p>{c.legal.telegramLabel}: <a href={links.telegram} target="_blank" rel="noopener">{c.site.telegramHandle}</a></p>
  {showTax && <p>{c.legal.taxLabel}: {c.legal.taxSystem}</p>}
</address>

<style>
  .business {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    font-style: normal;
    font-size: var(--fs-small);
    color: var(--fg-soft);
    overflow-wrap: anywhere;
  }
  .business__name { font-weight: var(--fw-strong); color: var(--fg); }
  .business__details { display: grid; gap: var(--space-3); }
  .business__details > div { display: flex; flex-wrap: wrap; gap: 0.4em; align-items: baseline; }
  .business__details dt { color: var(--fg-mute); }
  .business__details dd { white-space: nowrap; }
  .business a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .business a:hover, .business a:focus-visible { color: var(--stamp); }
  @media (hover: none) {
    .business a { display: inline-block; padding-block: 0.5rem; }
  }
</style>
