---
import { Icon } from 'astro-icon/components';
import { nav, cta, socials } from '../data/content';
---

<!-- Слой 1: вуаль. Прогрессивный блюр: сильный у кромки, сходит на нет книзу. -->
<div class="veil" data-nav-veil aria-hidden="true"></div>

<!-- Слой 2: контент. mix-blend-difference инвертируется на любом фоне сам,
     поэтому хедер бесшовный: никаких переключений светлый/тёмный. -->
<header class="nav" data-nav>
  <div class="shell nav__inner">
    <div class="nav__left">
      <a class="nav__mark" href="#top">
        <span class="nav__name"><span class="nav__given">Евгений </span>Геркулесов</span>
      </a>
      <nav class="nav__links" aria-label="Разделы страницы">
        {nav.map((item) => <a class="nav__link" href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    <div class="nav__right">
      <ul class="nav__socials">
        {
          socials.map((s) =>
            s.href ? (
              <li>
                <a class="iconbtn nav__social" href={s.href} target="_blank" rel="noopener" aria-label={s.name} data-magnetic>
                  <Icon name={s.icon} />
                </a>
              </li>
            ) : (
              /* TODO(заказчик): адрес не выдан — иконка стоит, но не кликается */
              <li>
                <span class="iconbtn nav__social nav__social--soon" aria-label={`${s.name}: ссылка скоро появится`} title="Скоро">
                  <Icon name={s.icon} />
                </span>
              </li>
            ),
          )
        }
      </ul>
      <a class="btn nav__cta" href={cta.href} target="_blank" rel="noopener" data-magnetic>
        <span>{cta.label}</span>
        <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
      </a>
    </div>
  </div>
</header>

<style>
  /* --------------------------------------------------------------------
     Хедер-гармошка. Наверху разложен широко, по скроллу --nav-t (мотор)
     сжимает его в компактную полоску. На фазе вопроса hero хедера нет:
     мотор вешает [data-away], хедер выезжает вместе с перетеканием фона.
     -------------------------------------------------------------------- */

  .veil {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: calc(var(--z-nav) - 1);
    height: calc(140px - 48px * var(--nav-t, 0));
    pointer-events: none;
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    /* Градиентная маска: у кромки блюр в полную силу, книзу постепенно
       исчезает — контент под хедером размывается плавно, без ступеньки. */
    mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 100%);
    opacity: var(--nav-t, 0);
    transition: opacity var(--dur-mid) var(--ease-out);
  }

  .nav {
    --nav-t: 0;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    height: calc(112px - 48px * var(--nav-t));
    display: flex;
    align-items: center;
    /* Всё содержимое белое; difference инвертирует его против фона. */
    color: #fff;
    mix-blend-mode: difference;
    transition: opacity var(--dur-mid) var(--ease-out),
                translate var(--dur-mid) var(--ease-out);
  }

  .nav[data-away],
  .veil[data-away] {
    opacity: 0;
    pointer-events: none;
  }
  .nav[data-away] { translate: 0 -14px; }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__left,
  .nav__right {
    display: flex;
    align-items: center;
    gap: calc(2.75rem - 1.5rem * var(--nav-t));
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    font-weight: 650;
    font-size: calc(1.5rem - 0.42rem * var(--nav-t));
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: calc(2.25rem - 0.9rem * var(--nav-t));
  }

  .nav__link {
    position: relative;
    font-size: calc(1.2rem - 0.22rem * var(--nav-t));
    font-weight: 500;
    opacity: 0.72;
    padding-block: 0.35rem;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--hair);
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link:focus-visible { opacity: 1; }
  .nav__link:hover::after,
  .nav__link:focus-visible::after { transform: scaleX(1); }

  .nav__socials {
    display: flex;
    align-items: center;
    gap: calc(0.9rem - 0.4rem * var(--nav-t));
  }

  .nav__social {
    width: calc(3.1rem - 0.55rem * var(--nav-t));
    height: calc(3.1rem - 0.55rem * var(--nav-t));
    border-color: rgb(255 255 255 / 0.34);
    color: #fff;
  }
  .nav__social:hover,
  .nav__social:focus-visible {
    /* Внутри difference цветных заливок нет: ховер — плотность рамки. */
    background: transparent;
    border-color: #fff;
    color: #fff;
  }

  .nav__social--soon { opacity: 0.35; cursor: default; }
  .nav__social--soon:hover { border-color: rgb(255 255 255 / 0.34); }

  .nav__cta {
    padding: calc(1rem - 0.3rem * var(--nav-t)) calc(1.6rem - 0.4rem * var(--nav-t));
    font-size: var(--fs-small);
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  /* Оранжевая заливка из .btn исказилась бы difference-режимом. */
  .nav__cta::before { display: none; }
  .nav__cta:hover, .nav__cta:focus-visible { color: #000; }

  /* Без мотора: хедер виден и сразу компактный, подложка активна. */
  :global(html:not(.motion)) .nav,
  :global(html:not(.motion)) .veil { --nav-t: 1; }

  @media (max-width: 1180px) {
    .nav__links { display: none; }
  }

  @media (max-width: 780px) {
    .nav { height: calc(84px - 20px * var(--nav-t)); }
    .veil { height: calc(110px - 20px * var(--nav-t, 0)); }
    .nav__socials { display: none; }
    .nav__mark { font-size: calc(1.05rem - 0.15rem * var(--nav-t)); }
  }

  @media (max-width: 480px) {
    .nav__cta { padding-inline: 0.8rem; gap: var(--space-2); }
  }
  @media (max-width: 420px) {
    .nav__given { display: none; }
  }
</style>

<script is:inline>
  // До старта мотора хедер на фазе вопроса скрыт, но только когда движение
  // разрешено. Если мотор не доехал за 4 секунды, возвращаем хедер: страница
  // обязана оставаться полноценной без JS-модуля.
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const nav = document.querySelector('[data-nav]');
    const veil = document.querySelector('[data-nav-veil]');
    nav?.setAttribute('data-away', '');
    veil?.setAttribute('data-away', '');
    setTimeout(() => {
      if (!document.documentElement.classList.contains('motion')) {
        nav?.removeAttribute('data-away');
        veil?.removeAttribute('data-away');
      }
    }, 4000);
  })();
</script>
