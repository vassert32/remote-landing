---
import { Icon } from 'astro-icon/components';
import { nav, cta, site, socials } from '../data/content';
---

<header class="nav" data-nav>
  <div class="shell nav__inner">
    <div class="nav__left">
      <a class="nav__mark" href="#top">
        <span class="nav__glyph" aria-hidden="true"></span>
        <span class="nav__name"><span class="nav__given">Евгений </span>Геркулесов</span>
      </a>
      <nav class="nav__links" aria-label="Разделы страницы">
        {nav.map((item) => <a class="nav__link" href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    <div class="nav__right">
      <ul class="nav__socials">
        {
          socials.map((s) =>
            s.href ? (
              <li>
                <a class="iconbtn nav__social" href={s.href} target="_blank" rel="noopener" aria-label={s.name} data-magnetic>
                  <Icon name={s.icon} />
                </a>
              </li>
            ) : (
              /* TODO(заказчик): адрес не выдан — иконка стоит, но не кликается */
              <li>
                <span class="iconbtn nav__social nav__social--soon" aria-label={`${s.name}: ссылка скоро появится`} title="Скоро">
                  <Icon name={s.icon} />
                </span>
              </li>
            ),
          )
        }
      </ul>
      <a class="btn btn--ink nav__cta" href={cta.href} target="_blank" rel="noopener" data-magnetic>
        <span>{cta.label}</span>
        <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
      </a>
    </div>
  </div>
</header>

<style>
  /* --------------------------------------------------------------------
     Хедер-гармошка. Наверху страницы разложен широко: высокая строка,
     крупные буквы, блоки прижаты к краям. По мере скролла --nav-t идёт
     0 → 1 (мотор пишет её через ScrollTrigger), и все размеры плавно
     интерполируются к компактной полоске. Без мотора хедер сразу компактный
     (фоллбек в конце файла). Тема (чернила/бумага) следует за секцией
     под хедером: атрибут data-on-dark вешает мотор.
     -------------------------------------------------------------------- */
  .nav {
    --nav-t: 0;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    /* 112px наверху → 64px в поездке */
    height: calc(112px - 48px * var(--nav-t));
    display: flex;
    align-items: center;
    color: var(--fg);
    transition: color var(--dur-mid) var(--ease-out);
  }

  /* Подложка проявляется вместе со сжатием. */
  .nav::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: var(--hair) solid var(--line-strong);
    opacity: var(--nav-t);
  }

  /* Хедер-хамелеон: над тёмной секцией живёт в тёмной семантике. */
  .nav[data-on-dark] {
    --bg: var(--coal);
    --fg: var(--paper);
    --fg-soft: color-mix(in srgb, var(--paper) 80%, var(--coal));
    --line-strong: color-mix(in srgb, var(--paper) 32%, transparent);
    --stamp: #5061ff;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__left,
  .nav__right {
    display: flex;
    align-items: center;
    /* Широкие зазоры наверху съезжаются вместе с хедером. */
    gap: calc(2.75rem - 1.5rem * var(--nav-t));
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 650;
    /* Крупные буквы наверху: 1.25rem → 0.9rem */
    font-size: calc(1.25rem - 0.35rem * var(--nav-t));
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav__glyph {
    width: 0.55em;
    height: 0.55em;
    flex: none;
    background: var(--stamp);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: calc(2.25rem - 0.9rem * var(--nav-t));
  }

  .nav__link {
    position: relative;
    font-size: calc(1.05rem - 0.2rem * var(--nav-t));
    font-weight: 500;
    color: var(--fg-soft);
    padding-block: 0.35rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--hair);
    background: var(--stamp);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link:focus-visible { color: var(--fg); }
  .nav__link:hover::after,
  .nav__link:focus-visible::after { transform: scaleX(1); }

  .nav__socials {
    display: flex;
    align-items: center;
    gap: calc(0.9rem - 0.4rem * var(--nav-t));
  }

  .nav__social {
    width: calc(2.75rem - 0.45rem * var(--nav-t));
    height: calc(2.75rem - 0.45rem * var(--nav-t));
  }

  .nav__social--soon {
    opacity: 0.38;
    cursor: default;
  }
  .nav__social--soon:hover { background: transparent; border-color: var(--line-strong); color: var(--fg); }

  .nav__cta {
    padding: calc(0.85rem - 0.23rem * var(--nav-t)) calc(1.4rem - 0.3rem * var(--nav-t));
    font-size: var(--fs-micro);
  }

  /* Без мотора сжатие не работает: держим хедер сразу компактным с подложкой. */
  :global(html:not(.motion)) .nav { --nav-t: 1; }

  @media (max-width: 1180px) {
    .nav__links { display: none; }
  }

  @media (max-width: 780px) {
    .nav { height: calc(84px - 20px * var(--nav-t)); }
    .nav__socials { display: none; }
    .nav__name { white-space: nowrap; }
    .nav__mark { font-size: calc(1.05rem - 0.15rem * var(--nav-t)); }
  }

  @media (max-width: 480px) {
    .nav__cta { padding-inline: 0.8rem; gap: var(--space-2); }
  }
  @media (max-width: 420px) {
    .nav__given { display: none; }
  }
</style>
