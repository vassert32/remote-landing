---
import { Icon } from 'astro-icon/components';
import { t, socialHref, otherLang, path, links } from '../i18n';

const c = t(Astro.currentLocale);
const alt = otherLang(Astro.currentLocale);
---

<!-- Слой 1: вуаль. Прогрессивный блюр: сильный у кромки, сходит на нет книзу. -->
<div class="veil" data-nav-veil aria-hidden="true"></div>

<!-- Слой 2: контент. mix-blend-difference инвертируется на любом фоне сам,
     поэтому хедер бесшовный: никаких переключений светлый/тёмный. -->
<header class="nav" data-nav>
  <div class="nav__inner">
    <div class="nav__left">
      <a class="nav__mark" href="#top">
        <span class="nav__name"><span class="nav__given">{c.site.given}</span>{c.site.family}</span>
      </a>

      <nav class="nav__links" aria-label={c.ui.navLabel}>
        {c.nav.map((item) => <a class="nav__link" href={item.href}>{item.label}</a>)}
      </nav>

      <!-- Переключатель языка: намеренно тихий, живёт сразу за навигацией. -->
      <a class="nav__lang" href={path(alt, '/')} hreflang={alt} lang={alt} title={c.switchLabel}>
        <Icon name="ph:globe-simple" class="nav__lang-icon" aria-hidden="true" />
        <span>{c.switchTo}</span>
      </a>
    </div>

    <div class="nav__right">
      <ul class="nav__socials">
        {
          c.socials.map((s) => {
            const href = socialHref(s.key);
            return href ? (
              <li>
                <a class="iconbtn nav__social" href={href} target="_blank" rel="noopener" aria-label={s.name} data-magnetic>
                  <Icon name={s.icon} />
                </a>
              </li>
            ) : (
              /* TODO(заказчик): адрес не выдан — иконка стоит, но не кликается */
              <li>
                <span class="iconbtn nav__social nav__social--soon" aria-label={c.ui.soonAria(s.name)} title={c.ui.soon}>
                  <Icon name={s.icon} />
                </span>
              </li>
            );
          })
        }
      </ul>

      <a class="btn nav__cta" href={links.telegram} target="_blank" rel="noopener" data-magnetic>
        <span class="nav__cta-full">{c.cta.label}</span>
        <span class="nav__cta-short">{c.cta.short}</span>
        <Icon class="btn__arrow" name="ph:arrow-up-right-bold" />
      </a>
    </div>
  </div>
</header>

<style>
  /* --------------------------------------------------------------------
     Хедер-гармошка. Наверху разложен широко, по скроллу --nav-t (мотор)
     сжимает его в компактную полоску. На фазе вопроса hero хедера нет:
     мотор вешает [data-away], хедер выезжает вместе с перетеканием фона.
     -------------------------------------------------------------------- */

  .veil {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: calc(var(--z-nav) - 1);
    height: calc(150px - 48px * var(--nav-t, 0));
    pointer-events: none;
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    /* Градиентная маска: у кромки блюр в полную силу, книзу постепенно
       исчезает — контент под хедером размывается плавно, без ступеньки. */
    mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 100%);
    opacity: var(--nav-t, 0);
    transition: opacity var(--dur-mid) var(--ease-out);
  }

  .nav {
    --nav-t: 0;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    height: calc(124px - 48px * var(--nav-t));
    display: flex;
    align-items: center;
    /* Всё содержимое белое; difference инвертирует его против фона. */
    color: #fff;
    mix-blend-mode: difference;
    transition: opacity var(--dur-mid) var(--ease-out),
                translate var(--dur-mid) var(--ease-out);
  }

  .nav[data-away],
  .veil[data-away] {
    opacity: 0;
    pointer-events: none;
  }
  .nav[data-away] { translate: 0 -14px; }

  /* Хедер намеренно ШИРЕ контентной сетки: свой контейнер и меньшие поля.
     Прижатые к краям экрана края снимают ощущение строгой коробки. */
  .nav__inner {
    width: 100%;
    max-width: 1560px;
    margin-inline: auto;
    /* Ровно на шаг шире контентной сетки: поля меньше --page-pad на 1rem.
       Достаточно, чтобы коробка не читалась строгой, и не настолько,
       чтобы хедер уезжал к самому краю экрана. */
    padding-inline: max(1rem, calc(var(--page-pad) - 1rem));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__left,
  .nav__right {
    display: flex;
    align-items: center;
    gap: calc(3rem - 1.4rem * var(--nav-t));
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    font-weight: var(--fw-strong);
    font-size: calc(1.5rem - 0.42rem * var(--nav-t));
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: calc(2.25rem - 0.9rem * var(--nav-t));
  }

  .nav__link {
    position: relative;
    font-size: calc(1.2rem - 0.22rem * var(--nav-t));
    font-weight: var(--fw-medium);
    opacity: 0.72;
    padding-block: 0.35rem;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--hair);
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link:focus-visible { opacity: 1; }
  .nav__link:hover::after,
  .nav__link:focus-visible::after { transform: scaleX(1); }

  /* Переключатель языка: тихий и мелкий, не спорит с навигацией. */
  .nav__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-inline-start: calc(-1.4rem + 0.6rem * var(--nav-t));
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    opacity: 0.62;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .nav__lang:hover,
  .nav__lang:focus-visible { opacity: 1; }
  .nav__lang-icon { width: 1em; height: 1em; flex: none; }

  .nav__socials {
    display: flex;
    align-items: center;
    gap: calc(0.9rem - 0.4rem * var(--nav-t));
  }

  .nav__social {
    width: calc(3.1rem - 0.55rem * var(--nav-t));
    height: calc(3.1rem - 0.55rem * var(--nav-t));
    border-color: rgb(255 255 255 / 0.34);
    color: #fff;
  }
  .nav__social:hover,
  .nav__social:focus-visible {
    /* Внутри difference цветных заливок нет: ховер — плотность рамки. */
    background: transparent;
    border-color: #fff;
    color: #fff;
  }

  .nav__social--soon { opacity: 0.35; cursor: default; }
  .nav__social--soon:hover { border-color: rgb(255 255 255 / 0.34); }

  .nav__cta {
    padding: calc(1rem - 0.3rem * var(--nav-t)) calc(1.6rem - 0.4rem * var(--nav-t));
    font-size: var(--fs-small);
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  /* Оранжевая заливка из .btn исказилась бы difference-режимом. */
  .nav__cta::before { display: none; }
  .nav__cta:hover, .nav__cta:focus-visible { color: #000; }

  /* Короткий лейбл живёт только на телефоне. */
  .nav__cta-short { display: none; }

  /* Без мотора: хедер виден и сразу компактный, подложка активна. */
  :global(html:not(.motion)) .nav,
  :global(html:not(.motion)) .veil { --nav-t: 1; }

  /* На таче И на узких окнах вуали нет. Две причины (DESIGN.md §14, М4):
     masked backdrop-filter белит тёмные секции, пока в них играют
     entrance-твины (Chromium теряет секцию из бэкдропа и блюрит фон html),
     и мажет заголовки, которые в мобильной вёрстке стоят почти сразу под
     хедером — узкое десктоп-окно с мышью ловит ровно ту же грязь.
     Difference-хедер читается на любом фоне и без подложки. */
  @media (hover: none), (pointer: coarse), (max-width: 900px) {
    .veil { display: none; }
  }

  /* Тач: переключатель языка был 36x17, марка 107x30 — обе меньше 44px.
     Растим только высоту касания, вид не трогаем. */
  @media (hover: none) {
    .nav__lang,
    .nav__mark {
      min-height: 44px;
      align-items: center;
    }
    .nav__mark { display: inline-flex; }
  }

  @media (max-width: 1180px) {
    .nav__links { display: none; }
    .nav__lang { margin-inline-start: 0; }
  }

  @media (max-width: 780px) {
    .nav { height: calc(92px - 20px * var(--nav-t)); }
    .veil { height: calc(118px - 20px * var(--nav-t, 0)); }
    .nav__socials { display: none; }
    .nav__mark { font-size: calc(1.2rem - 0.15rem * var(--nav-t)); }
    .nav__left { gap: var(--space-6); }
  }

  /* Кнопка-компакт: полный «Записаться на разбор» на телефоне спорил
     шириной с именем и выглядел несуразно. Остаются глагол и стрелка. */
  @media (max-width: 780px) {
    .nav__cta-full { display: none; }
    .nav__cta-short { display: inline; }
    .nav__cta { padding: 0.55rem 0.8rem; gap: var(--space-2); }
  }
  @media (max-width: 420px) {
    .nav__given { display: none; }
  }
</style>

<script is:inline>
  // До старта мотора хедер на фазе вопроса скрыт, но только когда движение
  // разрешено. Если мотор не доехал за 4 секунды, возвращаем хедер: страница
  // обязана оставаться полноценной без JS-модуля.
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const nav = document.querySelector('[data-nav]');
    const veil = document.querySelector('[data-nav-veil]');
    nav?.setAttribute('data-away', '');
    veil?.setAttribute('data-away', '');
    setTimeout(() => {
      if (!document.documentElement.classList.contains('motion')) {
        nav?.removeAttribute('data-away');
        veil?.removeAttribute('data-away');
      }
    }, 4000);
  })();
</script>
