---
import { Icon } from 'astro-icon/components';
import { t } from '../i18n';

const c = t(Astro.currentLocale);

/**
 * Пары «подойдёт/не подойдёт» лежат в одной грид-строке: их линии совпадают
 * по горизонтали. Форма бланка-анкеты: номер строки, бокс отметки, текст.
 */
const rows = c.fit.yes.map((yes, i) => ({ yes, no: c.fit.no[i] ?? '', n: i + 1 }));
---

<section class="section fitcheck">
  <div class="shell">
    <h2 class="h2 fitcheck__title" data-split>{c.fit.title}</h2>

    <div class="panel fitcheck__panel" data-reveal="up">

      <div class="fitcheck__table">
        <h3 class="fitcheck__colhead">
          <Icon name="ph:check-bold" class="fitcheck__mark fitcheck__mark--yes" aria-hidden="true" />
          <span>{c.fit.yesTitle}</span>
        </h3>
        <h3 class="fitcheck__colhead fitcheck__colhead--no">
          <Icon name="ph:x-bold" class="fitcheck__mark" aria-hidden="true" />
          <span>{c.fit.noTitle}</span>
        </h3>

        {
          rows.map((row) => (
            <>
              <p class="fitcheck__item">
                <span class="fitcheck__n num" aria-hidden="true">{row.n}</span>
                <span class="fitcheck__box fitcheck__box--yes" aria-hidden="true">
                  <Icon name="ph:check-bold" />
                </span>
                <span>{row.yes}</span>
              </p>
              <p class="fitcheck__item fitcheck__item--no">
                <span class="fitcheck__box" aria-hidden="true"></span>
                <span>{row.no}</span>
              </p>
            </>
          ))
        }
      </div>

    </div>
  </div>
</section>

<style>
  .fitcheck__title { margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem); max-width: 16ch; }


  .fitcheck__table {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: stretch;
  }

  .fitcheck__colhead {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--fg);
    font-size: var(--fs-h3);
    font-weight: var(--fw-strong);
    letter-spacing: -0.014em;
  }
  .fitcheck__colhead--no { color: var(--fg-mute); border-bottom-color: var(--line-strong); }

  .fitcheck__mark { width: 0.8em; height: 0.8em; flex: none; }
  .fitcheck__mark--yes { color: var(--stamp); }

  /* Строка анкеты: номер, бокс отметки, текст. */
  .fitcheck__item {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: start;
    gap: 0.75rem;
    margin: 0;
    padding-block: var(--space-4);
    border-bottom: var(--hair) solid var(--line);
    text-wrap: pretty;
  }
  .fitcheck__item--no {
    grid-template-columns: auto 1fr;
    color: var(--fg-mute);
  }

  .fitcheck__n {
    font-size: var(--fs-micro);
    color: var(--fg-mute);
    padding-top: 0.28em;
  }

  /* Бокс отметки: слева проставлен, справа намеренно пустой. */
  .fitcheck__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    margin-top: 0.22em;
    border: var(--hair) solid var(--line-strong);
    color: var(--stamp);
  }
  .fitcheck__box--yes { border-color: var(--stamp); }
  .fitcheck__box :global(svg) { width: 0.7rem; height: 0.7rem; }
  .fitcheck__item--no .fitcheck__box { border-style: dashed; }


  /* Мобайл: сетка складывается в две группы порядком через order. */
  @media (max-width: 780px) {
    .fitcheck__title { margin-bottom: var(--space-6); }
    .fitcheck__table { grid-template-columns: minmax(0, 1fr); }
    .fitcheck__colhead { order: 1; }
    .fitcheck__item { order: 2; padding-block: var(--space-3); }
    .fitcheck__colhead--no { order: 3; margin-top: var(--space-6); }
    .fitcheck__item--no { order: 4; }
  }
</style>
