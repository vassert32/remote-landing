---
/**
 * Пробник разворота листа. Служебная страница: /fold
 * Три прочтения одной идеи — лист приходит снизу изнанкой и разворачивается
 * в наш JOB OFFER. Крутить колесом: разворот привязан к скроллу, как в герое.
 *
 * 3D-ассет не нужен: всё на CSS-перспективе, лист остаётся живым текстом —
 * выделяется мышью, читается скринридером, весит ноль.
 *
 * После выбора страница удаляется, победивший вариант переезжает в Hero.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import OfferDoc from '../components/OfferDoc.astro';

const variants = [
  { id: 'flip', n: 'А', title: 'Переворот листа', note: 'приходит изнанкой, поворачивается к тебе целиком' },
  { id: 'corner', n: 'Б', title: 'Загнутый угол', note: 'уголок отогнут назад и распрямляется на подъёме' },
  { id: 'half', n: 'В', title: 'Сложен пополам', note: 'как письмо: нижняя половина откидывается вниз' },
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Пробник разворота листа</title>
  </head>
  <body>
    <header class="shell probe__head">
      <h1 class="h2">Разворот листа</h1>
      <p class="label">служебная страница · крути колесом, разворот привязан к скроллу</p>
    </header>

    {
      variants.map((v) => (
        <section class="stage" data-stage data-kind={v.id}>
          <div class="shell stage__inner">
            <div class="stage__meta">
              <span class="stage__n num-font">{v.n}</span>
              <h2 class="h3">{v.title}</h2>
              <p class="label stage__note">{v.note}</p>
            </div>

            <div class="scene">
              {/* Обёртка несёт подъём, .paper — только разворот: смешивать
                  их в одном transform нельзя, они живут по разным законам. */}
              <div class="lift" data-lift>
                {v.id === 'flip' && (
                  <div class="paper" data-paper>
                    <div class="face">
                      <OfferDoc />
                    </div>
                    <div class="face face--back" aria-hidden="true" />
                  </div>
                )}

                {v.id === 'corner' && (
                  <div class="paper paper--corner">
                    {/* Лицо с вырезанным углом: бумага не может быть в двух
                        местах сразу, поэтому там, где угол отогнут, лист пуст. */}
                    <div class="face" data-front>
                      <OfferDoc />
                    </div>
                    {/* Отогнутый угол — квадрат, обрезанный до треугольника
                        и повёрнутый на 180° вокруг своей главной диагонали. */}
                    <div class="dogear" data-fold aria-hidden="true">
                      <div class="dogear__skin" />
                    </div>
                  </div>
                )}

                {v.id === 'half' && (
                  <div class="paper paper--half">
                    {/* Обе половины — полноразмерные копии листа, отличаются
                        только обрезкой. Ось сгиба у обеих одна: середина. */}
                    <div class="half half--top">
                      <OfferDoc />
                    </div>
                    <div class="half half--bottom" data-half>
                      <div class="face">
                        <OfferDoc hidden />
                      </div>
                      <div class="face face--back" aria-hidden="true" />
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <section class="stage stage--end">
      <p class="shell label">конец пробника</p>
    </section>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      const EASE = 'power2.out';
      /* Размер отогнутого угла держим в одном месте: он нужен и повороту,
         и вырезу на лице листа. */
      const EAR = 132;

      for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
        const kind = stage.dataset.kind;
        const lift = stage.querySelector<HTMLElement>('[data-lift]');
        if (!lift) continue;

        const tl = gsap.timeline({
          scrollTrigger: { trigger: stage, start: 'top top', end: '+=130%', pin: true, scrub: 0.6 },
        });

        // Подъём общий для всех вариантов: лист приходит из-за нижней кромки.
        gsap.set(lift, { yPercent: 58, opacity: 0 });
        tl.to(lift, { yPercent: 0, opacity: 1, duration: 0.55, ease: EASE }, 0);

        if (kind === 'flip') {
          const paper = stage.querySelector<HTMLElement>('[data-paper]');
          if (paper) {
            gsap.set(paper, { rotateX: 180 });
            tl.to(paper, { rotateX: 0, duration: 0.62, ease: EASE }, 0.2);
          }
        }

        if (kind === 'corner') {
          const fold = stage.querySelector<HTMLElement>('[data-fold]');
          const front = stage.querySelector<HTMLElement>('[data-front]');
          if (fold && front) {
            // Угол отогнут, у листа вырезан тот же угол. Величины идут в ногу.
            const cut = (px: number) =>
              `polygon(0 0, calc(100% - ${px}px) 0, 100% ${px}px, 100% 100%, 0 100%)`;
            gsap.set(fold, { '--fold': '180deg' });
            gsap.set(front, { clipPath: cut(EAR) });
            const state = { px: EAR };
            tl.to(fold, { '--fold': '0deg', duration: 0.62, ease: EASE }, 0.2).to(
              state,
              {
                px: 0,
                duration: 0.62,
                ease: EASE,
                onUpdate: () => gsap.set(front, { clipPath: cut(state.px) }),
              },
              0.2,
            );
          }
        }

        if (kind === 'half') {
          const bottom = stage.querySelector<HTMLElement>('[data-half]');
          if (bottom) {
            // Нижняя половина откинута вверх на себя: видно её изнанку.
            gsap.set(bottom, { rotateX: 180 });
            tl.to(bottom, { rotateX: 0, duration: 0.62, ease: EASE }, 0.2);
          }
        }
      }
    </script>

    <style is:global>
      .probe__head { padding-block: var(--space-16) var(--space-8); display: grid; gap: var(--space-2); }

      .stage { min-height: 100dvh; display: flex; align-items: center; }
      .stage--end { min-height: 60dvh; }

      .stage__inner {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
        gap: var(--space-12);
        align-items: center;
      }
      @media (max-width: 900px) {
        .stage__inner { grid-template-columns: minmax(0, 1fr); }
      }

      .stage__meta { display: grid; gap: var(--space-3); align-content: center; }
      .stage__n { font-size: var(--fs-giant); line-height: 0.8; color: var(--stamp); }
      .stage__note { max-width: 26ch; }

      /* Перспектива живёт на сцене, а не на самом листе: иначе поворот
         считается от его собственного центра и выглядит плоской разверткой. */
      .scene { perspective: 1600px; perspective-origin: 50% 45%; }

      .lift { will-change: transform, opacity; }

      .paper {
        position: relative;
        transform-style: preserve-3d;
      }

      .face { backface-visibility: hidden; }

      /* Изнанка лежит ровно под лицом и повёрнута от нас. Тени в проекте
         запрещены, поэтому «неосвещённость» даётся градиентом по бумаге. */
      .face--back {
        position: absolute;
        inset: 0;
        transform: rotateX(180deg);
        background-color: #e2dfd6;
        background-image: linear-gradient(
          160deg,
          rgb(0 0 0 / 0.30),
          rgb(0 0 0 / 0.10) 45%,
          rgb(0 0 0 / 0.24)
        );
        border: var(--hair) solid color-mix(in srgb, var(--ink) 22%, transparent);
      }

      /* --- Б: загнутый угол ------------------------------------------- */

      .dogear {
        position: absolute;
        top: 0;
        right: 0;
        width: 132px;
        height: 132px;
        transform-origin: 0 0;
        transform: rotate3d(1, 1, 0, var(--fold, 180deg));
      }
      .dogear__skin {
        position: absolute;
        inset: 0;
        /* Треугольник A-B-C: он же угол листа. Гипотенуза — главная
           диагональ квадрата, вокруг неё и происходит сгиб. */
        clip-path: polygon(0 0, 100% 0, 100% 100%);
        background-color: #ddd9d0;
        background-image: linear-gradient(225deg, rgb(0 0 0 / 0.04), rgb(0 0 0 / 0.26));
        border: var(--hair) solid color-mix(in srgb, var(--ink) 20%, transparent);
      }

      /* --- В: сложен пополам ------------------------------------------- */

      .paper--half { transform-style: preserve-3d; }
      .half { transform-style: preserve-3d; }
      .half--top { clip-path: inset(0 0 50% 0); }
      .half--bottom {
        position: absolute;
        inset: 0;
        clip-path: inset(50% 0 0 0);
        /* Ось сгиба — середина листа, она же центр обеих копий. */
        transform-origin: 50% 50%;
      }
    </style>
  </body>
</html>
