---
/**
 * Пробник: лист прилетает на стол и раскладывается. Страница /fold.
 *
 * Загнут левый нижний угол — не плоским треугольником, а завитком: бумага
 * скручивается трубочкой, поэтому у неё блик по внешней дуге и затемнение
 * у линии сгиба. Всё рисуется одним SVG, 3D-ассет не нужен.
 *
 * ТЕНИ. Правило «теней нет» не нарушено: ни одного box-shadow и ни одного
 * размытия здесь нет. Вся светотень нарисована градиентами — это не тень
 * объекта, а собственная светотень бумаги, то есть часть её рисунка.
 * Ровно то, о чём говорит правило: плотность вместо размытия.
 *
 * После выбора страница удаляется, механика переезжает в Hero.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import OfferDoc from '../components/OfferDoc.astro';

/** Варианты отличаются только характером прилёта, завиток общий. */
const takes = [
  { id: 'toss', n: 'А', title: 'Бросок на стол', note: 'прилетает с наклоном, гасит его о стол и раскладывается' },
  { id: 'settle', n: 'Б', title: 'Мягкая посадка', note: 'приходит ровно, завиток распускается на подлёте' },
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Пробник: лист на стол</title>
  </head>
  <body>
    <header class="shell probe__head">
      <h1 class="h2">Лист прилетает на стол</h1>
      <p class="label">служебная страница · крути колесом, движение привязано к скроллу</p>
    </header>

    {
      takes.map((v) => (
        <section class="stage" data-stage data-kind={v.id}>
          <div class="shell stage__inner">
            <div class="stage__meta">
              <span class="stage__n num-font">{v.n}</span>
              <h2 class="h3">{v.title}</h2>
              <p class="label stage__note">{v.note}</p>
            </div>

            <div class="scene">
              {/* Тень стола: отдельным слоем под листом, потому что живёт
                  по своему закону — в полёте шире и мягче, на столе собранная. */}
              <div class="drop" data-drop />

              <div class="sheet" data-sheet>
                <div class="sheet__paper" data-paper>
                  <OfferDoc />
                </div>

                {/* Завиток. viewBox фиксированный, размер задают стили: при
                    распускании меняется одна величина, форма и градиенты
                    остаются на месте. */}
                <svg
                  class="curl"
                  data-curl
                  viewBox="0 0 100 100"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <defs>
                    <linearGradient
                      id={`face-${v.id}`}
                      x1="50"
                      y1="50"
                      x2="100"
                      y2="0"
                      gradientUnits="userSpaceOnUse"
                    >
                      {/* У сгиба бумага в тени, к внешней дуге выходит на блик
                          и снова уходит в полутон на самом краю трубочки. */}
                      <stop offset="0" stop-color="#9c9990" />
                      <stop offset="0.45" stop-color="#fcfbf8" />
                      <stop offset="1" stop-color="#cdc9c0" />
                    </linearGradient>
                    <linearGradient
                      id={`cast-${v.id}`}
                      x1="35"
                      y1="35"
                      x2="105"
                      y2="-5"
                      gradientUnits="userSpaceOnUse"
                    >
                      {/* Затухание нарисовано стопами, а не размытием:
                          у сгиба плотно, к краю сходит в ноль. */}
                      <stop offset="0" stop-color="#1c1a16" stop-opacity="0.34" />
                      <stop offset="0.55" stop-color="#1c1a16" stop-opacity="0.12" />
                      <stop offset="1" stop-color="#1c1a16" stop-opacity="0" />
                    </linearGradient>
                  </defs>

                  {/* Тень завитка на листе: тот же контур чуть крупнее, залит
                      затухающим градиентом. Размытия нет — только плотность. */}
                  <path class="curl__cast" d="M0,0 C74,2 104,34 104,104 Z" fill={`url(#cast-${v.id})`} />
                  <path class="curl__face" d="M0,0 C70,0 100,30 100,100 Z" fill={`url(#face-${v.id})`} />
                </svg>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <section class="stage stage--end">
      <p class="shell label">конец пробника</p>
    </section>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      /** Размер завитка в долях ширины листа при полном загибе. */
      const CURL = 0.28;

      for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
        const kind = stage.dataset.kind;
        const sheet = stage.querySelector<HTMLElement>('[data-sheet]');
        const paper = stage.querySelector<HTMLElement>('[data-paper]');
        const curl = stage.querySelector<SVGElement>('[data-curl]');
        const drop = stage.querySelector<HTMLElement>('[data-drop]');
        if (!sheet || !paper || !curl || !drop) continue;

        /* Завиток и вырез на листе — одна величина: бумага не может быть
           в двух местах сразу, поэтому там, где угол закручен, лист пуст. */
        const state = { k: 1 };
        const setCurl = () => {
          const px = Math.round(paper.offsetWidth * CURL * state.k);
          gsap.set(curl, { width: px, height: px, autoAlpha: state.k > 0.02 ? 1 : 0 });
          gsap.set(paper, {
            clipPath: `polygon(0 0, 100% 0, 100% 100%, ${px}px 100%, 0 calc(100% - ${px}px))`,
          });
        };
        setCurl();

        const tl = gsap.timeline({
          scrollTrigger: { trigger: stage, start: 'top top', end: '+=140%', pin: true, scrub: 0.65 },
        });

        if (kind === 'toss') {
          // Брошенный лист: приходит снизу с наклоном, гасит его о стол
          // и только у «касания» распускает угол.
          gsap.set(sheet, { yPercent: 70, rotate: -7, scale: 1.06, opacity: 0 });
          gsap.set(drop, { opacity: 0, scaleX: 1.16, scaleY: 1.5 });

          tl.to(sheet, { opacity: 1, duration: 0.16 }, 0)
            .to(sheet, { yPercent: 0, duration: 0.5, ease: 'power2.out' }, 0)
            // back.out даёт лёгкий перелёт: лист касается стола и осаживается.
            .to(sheet, { rotate: 0, scale: 1, duration: 0.62, ease: 'back.out(1.4)' }, 0.08)
            .to(drop, { opacity: 1, duration: 0.2 }, 0.02)
            .to(drop, { scaleX: 1, scaleY: 1, duration: 0.55, ease: 'power2.out' }, 0.08)
            .to(state, { k: 0, duration: 0.42, ease: 'power2.inOut', onUpdate: setCurl }, 0.5);
        }

        if (kind === 'settle') {
          // Спокойная подача: угол распускается уже на подлёте.
          gsap.set(sheet, { yPercent: 46, rotate: -2, opacity: 0 });
          gsap.set(drop, { opacity: 0, scaleX: 1.1, scaleY: 1.32 });

          tl.to(sheet, { opacity: 1, duration: 0.16 }, 0)
            .to(sheet, { yPercent: 0, rotate: 0, duration: 0.6, ease: 'power3.out' }, 0)
            .to(drop, { opacity: 1, duration: 0.2 }, 0.02)
            .to(drop, { scaleX: 1, scaleY: 1, duration: 0.6, ease: 'power2.out' }, 0.04)
            .to(state, { k: 0, duration: 0.5, ease: 'power2.out', onUpdate: setCurl }, 0.22);
        }

        // Ширина листа зависит от окна — при пересчёте обновляем завиток.
        ScrollTrigger.addEventListener('refresh', setCurl);
      }
    </script>

    <style is:global>
      .probe__head { padding-block: var(--space-16) var(--space-8); display: grid; gap: var(--space-2); }

      .stage { min-height: 100dvh; display: flex; align-items: center; }
      .stage--end { min-height: 60dvh; }

      .stage__inner {
        display: grid;
        grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
        gap: var(--space-12);
        align-items: center;
      }
      @media (max-width: 900px) {
        .stage__inner { grid-template-columns: minmax(0, 1fr); }
      }

      .stage__meta { display: grid; gap: var(--space-3); align-content: center; }
      .stage__n { font-size: var(--fs-giant); line-height: 0.8; color: var(--stamp); }
      .stage__note { max-width: 26ch; }

      .scene { position: relative; }

      /* Падающая тень листа. Отдельным слоем, а не box-shadow: ей нужен свой
         закон движения — в полёте шире и мягче, чем на столе. */
      .drop {
        position: absolute;
        inset: 4% 0 -6% 0;
        /* Нарисованное затухание, не размытие: эллипс плотнее к низу листа
           и сходит в ноль к краям. */
        background: radial-gradient(
          ellipse 62% 46% at 50% 96%,
          rgb(28 26 22 / 0.30),
          rgb(28 26 22 / 0.10) 55%,
          rgb(28 26 22 / 0) 78%
        );
        transform-origin: 50% 100%;
        will-change: transform, opacity;
      }

      .sheet { position: relative; will-change: transform; }
      .sheet__paper { position: relative; }

      /* Завиток сидит в левом нижнем углу листа и распускается в ноль.
         Контур нарисован для правого верхнего угла, здесь он зеркалится. */
      .curl {
        position: absolute;
        left: 0;
        bottom: 0;
        transform: scale(-1, -1);
        overflow: visible;
        pointer-events: none;
      }
      .curl__face { stroke: none; }
      .curl__cast { transform: translate(2px, 3px); }
    </style>
  </body>
</html>
